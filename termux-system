#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# prompt ───────────────────────────────────────────────────────────────────────

console.script "Setting up ${script#*-}"

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

system_environment () {

	# generate environment '$PATH'

	# set path:
	# in order of retreival

	PATH=""

	# container

	[ -d "${PREFIX}"/cnt/usr/local/sbin ]			&& PATH+="/usr/local/sbin:"
	[ -d "${PREFIX}"/cnt/usr/local/bin ]			&& PATH+="/usr/local/bin:"
	[ -d "${PREFIX}"/cnt/usr/sbin ]					&& PATH+="/usr/sbin:"
	[ -d "${PREFIX}"/cnt/usr/sbin ]					&& PATH+="/usr/bin:"
	[ -d "${PREFIX}"/cnt/sbin ]						&& PATH+="/sbin:"
	[ -d "${PREFIX}"/cnt/bin ]						&& PATH+="/bin:"

	# termux

	[ -d "${PREFIX}"/sbin ]							&& PATH+="${PREFIX}/sbin:"
	[ -d "${PREFIX}"/bin ]							&& PATH+="${PREFIX}/bin:"

	# android

	[ -d /system/sbin ]								&& PATH+="/system/sbin:"
	[ -d /system/bin ]								&& PATH+="/system/bin:"

	# set environment

	PATH="${PATH}"

	cat <<- FILE > "${PREFIX}"/cnt/etc/environment
	PATH=${PATH}
	PREFIX=${PREFIX}

	FILE
}

system_groups () {

	# register android groups to container

	# set IFS

	IFS=' '

	# read android system IDs

	read id_user id_group text_groups <<< $(id)

	id_user=${id_user/uid=}
	id_group=${id_group/gid=}
	text_groups=${text_groups/groups=}

	# set IFS

	IFS=','

	# parse existing groups

	read -r -a list_groups <<< "${text_groups}"

	for line_group in "${list_groups[@]}"
	do
		line_group=${line_group/(/ }
		line_group=${line_group/)}

		# set IFS

		IFS=' '

		# transfer unregistered IDs

		read number_group name_group <<< ${line_group}

		if [ -f "${PREFIX}"/cnt/etc/group ]
		then
			echo "${name_group}:x:${number_group}:" >> "${PREFIX}"/cnt/etc/group
		fi

		if [ -f "${PREFIX}"/cnt/etc/gshadow ]
		then
			echo "${name_group}:x:${number_group}:" >> "${PREFIX}"/cnt/etc/gshadow
		fi
	done

	# reset IFS

	IFS=''
}

system_network () {

	# generate network files

	# hostname

	cat <<- 'FILE' > "${PREFIX}"/cnt/etc/hostname
	${HOSTNAME}

	FILE

	# hosts

	cat <<- 'FILE' > "${PREFIX}"/cnt/etc/hosts
	# IPv4 #

	127.0.0.1	localhost.localdomain
	127.0.0.1	localhost

	# IPv6 #

	::1			localhost.localdomain
	::1			localhost
	::1			ip6-localhost
	::1			ip6-loopbak
	fe00::0		ip6-localnet
	fe00::0		ip6-mcastprefix
	ff02::1		ip6-allnodes
	ff02::2		ip6-allrouters
	ff02::3		ip6-allhosts

	FILE

	# nameserver

	cat <<- 'FILE' > "${PREFIX}"/cnt/etc/resolv.conf
	nameserver 1.1.1.1
	nameserver 1.0.0.1

	FILE
}

system_preload () {

	# generate libgcc/libc location and add to dynamic linker for preload

	library_preload=$(find "${PREFIX}"/cnt/usr/lib -type f -iname "libgcc_s.so.1")

	# set preload

	cat <<- FILE > "${PREFIX}"/cnt/etc/ld.so.preload
	${library_preload}
	FILE
}

# generate environment variables

system_environment

# generate missing groups

system_groups

# generate network

system_network

# generate preload entries

system_preload
