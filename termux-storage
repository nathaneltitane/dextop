#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-l|--link)
			option="link"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -c | -e [Environment] | -t | -n | -b | -u [Update Type] [Utility Name] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-l, --link    Create [l]inks to unify storage directories."
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -c | -e [Environment] | -t | -n | -b | -u [Update Type] [Utility Name] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

intent_storage () {

	command_storage=()

	command_storage+=(am broadcast)
	command_storage+=(--user 0)
	command_storage+=(-e com.termux.app.reload_style storage)
	command_storage+=(-a com.termux.app.reload_style com.termux)

	frobulator.silence "${command_storage[@]}"
}

storage_directories () {

	# generate home directory structure

	list_directories+=(
		Desktop
		Documents
		Downloads
		Music
		Pictures
		Public
		Templates
		Videos
	)

	frobulator.directory "${directory_base}" ${list_directories[@]}

	list_directories=()
}

# verify termux storage directory existence

if [ ! -f "${HOME}"/.dextop/dextop-termux-storage ]
then
	if [ ! -d "${HOME}"/storage ]
	then
		# does not exist:
		# enable storage permissions: requires user touch input

		frobulator.wrn "User permission required to access storage on this device:"
		frobulator.nul "Both internal and external storage locations are made available."

		frobulator.inf "Storage is also made accessible through container."

		frobulator.ins "Select 'Allow' when prompted to proceed."

		frobulator.separate

		# storage permissions dialog

		intent_storage

		frobulator.countdown 5 "Continuing" "[ ${script} ]"

	else
		# exists:
		# proceed with setup

		frobulator.scs "Storage directory detected" "[ "${HOME}" ]"

		frobulator.fwd "Continuing${marker_elp}"
	fi

	frobulator.file "${HOME}"/.dextop dextop-termux-storage
fi

list_directories=(
	"${PREFIX}"/media
)

for directory in ${list_directories[@]}
do
	if [ -d "${directory}" ]
	then
		for item in "${directory}"/*
		do
			frobulator.delete "${item}"
		done
	fi
done

list_directories=()

# generate links

frobulator.fwd "Setting up storage${marker_elp}"

# link primary/internal android storage

frobulator.fwd "Linking${marker_elp}"

list_directories=(
	"${PREFIX}"/media
)

if [ -d /storage/self/primary ]
then
	for directory in ${list_directories[@]}
	do
		frobulator.link /storage/self "${directory}" primary Android
	done
fi

list_directories=()

# link external storage

# use /proc/mounts to detect mounted media:
# circumvent /storage access issues and DAC policy (Android 11+)

list_commands=(
	$(cat /proc/mounts | sed -r '/[A0-Z9]{4}[-][A0-Z9]{4}/!d' | grep '/storage' | cut -d ' ' -f 2)
	$(cat /proc/mounts | sed -r '/[A0-Z9]{40}/!d' | grep '/storage' | cut -d ' ' -f 2)
)

# set IFS

IFS=$'\n'

for command in ${list_commands[@]}
do
	read -r -a list_mounts_storage <<< ${command}

	for mount_storage in ${list_mounts_storage[@]}
	do
		 list_paths_storage+=("${mount_storage}")
	done
done

if [ -n "${#list_paths_storage[@]}" ]
then
	for path_storage in ${list_paths_storage[@]}
	do
		uuid_storage="${path_storage/\/storage\//}"

		if [ -f "${path_storage}"/.storage ]
		then
			label_storage=$(cat ${path_storage}/.storage)
		else
			frobulator.wrn "No storage identifier found" "[ ${uuid_storage} ]"

			frobulator.inf "Using mounts UUID for identification"

			frobulator.fwd "Proceeding${marker_elp}"
		fi

		frobulator.scs "Storage media detected" "[ ${uuid_storage} ]"

		if [ ! -f "${PREFIX}"/media/"${label_storage}" ]
		then
			frobulator.link /storage "${PREFIX}"/media "${uuid_storage}" "${label_storage}"
		fi

	done

else
	uuid_storage="N/A"

	frobulator.err "No storage media detected" "[ ${uuid_storage} ]"

	frobulator.fwd "Continuing${marker_elp}"
fi

list_commands=()

# reset IFS

IFS=''

# options

if [[ "${option}" = "link" ]]
then
	# link and unify home directory structure:
	# use  'Home' .storage label indicator

	if [ -d "${PREFIX}"/media/[hH][oO][mM][eE] ]
	then
		directory_base=("${PREFIX}"/media/[hH][oO][mM][eE])
	fi

	storage_directories

	# set IFS

	IFS=$'\n'

	list_directories=(
		$(ls "${directory_base}")
	)

	for directory in ${list_directories[@]}
	do
		read -r -a list_links <<< ${directory}

		if [[ -d "${HOME}"/"${directory}" ]]
		then
			frobulator.delete "${HOME}" "${directory}"
		fi

		if [[ -L "${HOME}"/"${directory}" ]]
		then
			break
		fi

		frobulator.link "${directory_base}" "${HOME}" ${list_links[@]}

		list_links=()
	done

	list_directories=()

	# reset IFS

	IFS=''

else

	directory_base="${HOME}"

	storage_directories
fi

# remove existing termux storage references

if [ -d "${HOME}"/storage ]
then
	frobulator.fwd "Cleaning up${marker_elp}"

	frobulator.delete "${HOME}" storage
fi
