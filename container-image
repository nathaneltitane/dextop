#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--image)
			option="image"
			name_distribution="${2}"

			shift

			version_distribution="${2}"

			shift
		;;

		-s|--selection)
			option="selection"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i [Distribution Name] [Distribution Version] | -s [Selection] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --image        Specify distribution [i]mage name and version."
			echo
			echo -e "-s, --selection    Show setup [s]election options."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i [Distribution Name] [Distribution Version] | -s [Selection] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

name_distribution="debian"

version_distribution="12"

codename_distribution="bookworm"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${name_distribution}" ]
then
	name_distribution="${name_distribution}"
fi

if [ -z "${version_distribution}" ]
then
	version_distribution="${version_distribution}"
fi

if [ -z "${codename_distribution}" ]
then
	codename_distribution="${codename_distribution}"
fi

# functions ────────────────────────────────────────────────────────────────────

image_select () {

	# list distributions for setup

	if [ -z "${name_distribution}"     ] ||
	   [ -z "${version_distribution}"  ] ||
	   [ -z "${codename_distribution}" ]
	then
		frobulator.msg "Select distribution version to setup."

		# list supported distribution versions

		list_versions_debian=(
			debian	10	buster
			debian	11	bullseye
			debian	12	bookworm
			debian	13	trixie
		)

		list_versions_ubuntu=(
			ubuntu	18.04	bionic
			ubuntu	20.04	focal
			ubuntu	22.04	jammy
			ubuntu	24.04	noble
		)

		list_versions=(
			${list_versions_debian[@]}
			${list_versions_ubuntu[@]}
		)

		# set padding for uniform output

		length_pad=10

		# continue list using array selection of suppported values

		for (( index_version = 0 ; index_version < ${#list_versions[@]} ; index_version += 3 ))
		do
			number_entry=$(( ( ${index_version} / 3 ) + 1 ))

			name_entry="${list_versions[${index_version}]}"
			version_entry="${list_versions[${index_version}+1]}"
			codename_entry="${list_versions[${index_version}+2]}"

			indent="${marker_tab}"

			if [ ${#version_entry} -le 2 ]
			then
				indent+="${marker_tab}"
			fi

			if (( ${index_version} / 3 >= 0 && ${index_version} / 3 <= 9 ))
			then
				# handle number spacing for entries 1-9

				number_entry=" ${number_entry}"
			else
				# handle number spacing for entries 10+

				number_entry="${number_entry}"
			fi

			echo "${marker_nul}" "[ ${number_entry} ]" "${name_entry}" "${version_entry}" "${indent}" "[ ${codename_entry} ]"

		done

		echo

		# values #

		list_values=(
			selection
		)

		# handle user input for list_values

		eval ${frobulator_return[@]}

		frobulator.ipt "Selection:"

		frobulator.read selection

		unset version_distribution

		# integer check:
		# handle numerical selection

		while [[ ! "${selection}" =~ ^[0-9]+$ ]]
		do
			echo
			frobulator.err "Invalid selection:"

			frobulator.wrn "Select image [ 1 - ${number_entry} ]"

			frobulator.ipt "Selection:"

			frobulator.read selection
		done

			index_version=$(( ${selection} ))
			index_version=$(( ( ${index_version} * 3 ) - 3 ))

			name_entry="${list_versions[${index_version}]}"
			version_entry="${list_versions[${index_version}+1]}"
			codename_entry="${list_versions[${index_version}+2]}"

			number_entry="${selection}"

			name_distribution="${name_entry}"
			version_distribution="${version_entry}"
			codename_distribution="${codename_entry}"

		# handle distribution code markup

		if [ "${name_distribution}" = ubuntu ]
		then
			# set IFS

			IFS='.'

			read year_release month_release revision_release <<< "${version_distribution}"

			if [ -z "${revision_release}" ]
			then
				release_distribution="${version_distribution}"
			else
				release_distribution="${version_distribution%.*}"
			fi

			# reset IFS

			IFS=''
		fi

		frobulator.inf "User selection" "[ ${selection} // ${name_entry} ${version_entry} - '${codename_entry}' ]"

		export name_distribution="${name_distribution}"
		export release_distribution="${release_distribution}"
		export version_distribution="${version_distribution}"
		export codename_distribution="${codename_distribution}"
	fi

}

architecture_image () {

	# compare processor architecture to available images architecture

	list_architectures_cpu=(
		aarch64
		arm
		amd64
		i*86
		x86_64
	)

	# list supported image architechtures

	if [ "${name_distribution}" = debian ]
	then
		list_architectures_image=(
			arm64v8
			arm32v7
			amd64
			i386
			amd64
		)
	fi

	if [ "${name_distribution}" = fedora ]
	then
		list_architectures_image=(
			aarch64
			armhfp
			x86_64
			x86_64
			x86_64
		)
	fi

	if [ "${name_distribution}" = ubuntu ]
	then
		list_architectures_image=(
			arm64
			armhf
			amd64
			i386
			amd64
		)
	fi

	# test processor architecture string

	architecture_device="$(uname -m)"

	for index_version in ${!list_architectures_cpu[@]}
	do
		if [[ "${architecture_device}" == "${list_architectures_cpu[index_version]}" ]]
		then
			architecture_image=${list_architectures_image[index_version]}

			frobulator.scs "Supported architecture" "[ ${architecture_image} ]"

			break
		fi
	done

	# test image architecture string

	if [ -z "${architecture_image}"  ] ||
	   [ -z "${architecture_device}" ]
	then
		architecture_image="N/A"

		frobulator.wrn "Unknown architecture" "[ ${architecture_image} ]"

		frobulator.fwd "Aborting${marker_elp}"

		frobulator.stp "Exiting."

		exit 1
	fi
}

image_download () {

	# generate links and download distribution image

	# handle distribution url

	case "${name_distribution}"
	in
		debian|ubuntu)
			extension_archive_image="tar.xz"

			url_image="get.trmnl.me"
			file_archive_image="archive-${name_distribution}-${version_distribution}.${extension_archive_image}"

			name_image="${name_distribution}-${version_distribution}"
			file_image="${name_image}.${extension_archive_image}"
		;;

	esac

	frobulator.download "${url_image}" "${file_archive_image}" "${PREFIX}"/img "${file_image}"

	frobulator.complete halt "Image download failed" "[ ${file_image} ]"
}

image_filesystem () {

	# exclude archive directories: dev | proc | sys | system
	# 'container-session' will bind those device directories to the container

	proot											\
		--link2symlink								\
			tar 									\
				--extract							\
				--delay-directory-restore			\
				--preserve-permissions				\
					--file="${1}"					\
							--exclude='boot'		\
							--exclude='dev'			\
							--exclude='proc'		\
							--exclude='sys'			\
							--exclude='system'		\
								--directory="${2}"	2> "${sink}"

	# validate extracted system: tar warnings under proot are not failures

	[ -e "${2}"/etc/os-release ]

	frobulator.complete halt "Image extraction failed" "[ ${1##*/} ]"

}

image_extract () {

	frobulator.wrn "Extracting new deployment" "[ ${file_image} // ${architecture_image} ]"

	frobulator.directory "${PREFIX}"/cnt "${name_distribution}"/"${version_distribution}"

	if [ "${name_distribution}" = debian ] ||
	   [ "${name_distribution}" = ubuntu ]
	then

		image_filesystem "${PREFIX}"/img/"${file_image}" "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"

	fi

	frobulator.complete

}

image_handle () {

case "${name_distribution}"
	in
		[dD][eE][bB][iI][aA][nN]| \
		[uU][bB][uU][nN][tT][uU])
			name_distribution="${name_distribution,,}"

			frobulator.scs "Supported distribution name."
		;;

		"")
			name_distribution="debian"

			frobulator.err "Empty distribution name."

			frobulator.wrn "Defaulting" "[ ${version_distribution} ]"
		;;

		*)
			name_distribution="debian"

			frobulator.err "Unsupported distribution name."

			frobulator.wrn "Defaulting" "[ ${name_distribution} ]"
		;;

	esac

	case "${name_distribution}" in
	debian)

		case "${version_distribution}"
		in
			11)
				version_distribution=11
			;;

			12)
				version_distribution=12
			 ;;

			 "")
				version_distribution=12

				frobulator.err "Distribution version not specified."

				frobulator.wrn "Defaulting" "[ ${version_distribution} ]"
			;;

			 *)
				version_distribution=12

				frobulator.err "Unsupported distribution version."

				frobulator.wrn "Defaulting" "[ ${version_distribution} ]"
			;;

		esac
	;;

	ubuntu)

		case "${version_distribution}"
		in
			18*04|18*04*)
				version_distribution="18.04"

				frobulator.scs "Supported distribution version" "[ ${version_distribution} ]"
			;;

			20*04|20*04*)
				version_distribution="20.04"

				frobulator.scs "Supported distribution version" "[ ${version_distribution} ]"
			;;

			22*04|22*04*)
				version_distribution="22.04"

				frobulator.scs "Supported distribution version" "[ ${version_distribution} ]"
			;;

			24*04|24*04*)
				version_distribution="24.04"

				frobulator.scs "Supported distribution version" "[ ${version_distribution} ]"
			;;

			"")
				version_distribution="${version_distribution}"

				frobulator.err "Distribution version not specified."

				frobulator.wrn "Defaulting" "[ ${version_distribution} ]"
			;;

			 *)
				version_distribution="${version_distribution}"

				frobulator.err "Unsupported distribution version."

				frobulator.wrn "Defaulting" "[ ${version_distribution} ]"
			;;

		esac

	;;

	esac

	frobulator.complete

}

image_environment () {

	# generate environment '$PATH' variable

	CONTAINER_ROOT="${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"

	# set path:
	# in order of retreival

	CONTAINER_PATH=""

	# container

	[ -d "${CONTAINER_ROOT}"/usr/local/sbin ] && CONTAINER_PATH+="/usr/local/sbin:"
	[ -d "${CONTAINER_ROOT}"/usr/local/bin ]  && CONTAINER_PATH+="/usr/local/bin:"
	[ -d "${CONTAINER_ROOT}"/usr/sbin ]       && CONTAINER_PATH+="/usr/sbin:"
	[ -d "${CONTAINER_ROOT}"/usr/bin ]        && CONTAINER_PATH+="/usr/bin:"
	[ -d "${CONTAINER_ROOT}"/sbin ]           && CONTAINER_PATH+="/sbin:"
	[ -d "${CONTAINER_ROOT}"/bin ]            && CONTAINER_PATH+="/bin:"

	# termux

	[ -d "${HOME}"/.local/sbin ]    && CONTAINER_PATH+="${HOME}/.local/sbin:"
	[ -d "${HOME}"/.local/bin ]     && CONTAINER_PATH+="${HOME}/.local/bin:"
	[ -d "${HOME}"/.sbin ]          && CONTAINER_PATH+="${HOME}/.sbin:"
	[ -d "${HOME}"/.bin ]           && CONTAINER_PATH+="${HOME}/.bin:"

	[ -d "${PREFIX}"/sbin ]         && CONTAINER_PATH+="${PREFIX}/sbin:"
	[ -d "${PREFIX}"/bin ]          && CONTAINER_PATH+="${PREFIX}/bin:"

	# android

	[ -d /system/sbin ]             && CONTAINER_PATH+="/system/sbin:"
	[ -d /system/bin ]              && CONTAINER_PATH+="/system/bin:"

	# set environment

	PATH="${PATH}"

	cat <<- FILE > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/environment
	PATH=${CONTAINER_PATH}
	PREFIX=${PREFIX}
	FILE

	unset CONTAINER_ROOT

	frobulator.complete

}

image_groups () {

	# register android groups to container

	# set IFS

	IFS=' '

	# read android system IDs

	read id_user id_group text_groups <<< $(id)

	id_user=${id_user/uid=}
	id_group=${id_group/gid=}

	text_groups=${text_groups/groups=}

	# set IFS

	IFS=','

	# parse existing groups

	read -r -a list_groups <<< "${text_groups}"

	for line_group in "${list_groups[@]}"
	do
		line_group=${line_group/(/ }
		line_group=${line_group/)}

		# set IFS

		IFS=' '

		# transfer unregistered IDs

		read number_group name_group <<< ${line_group}

		if [ -f "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/group ]
		then
			echo "${name_group}:x:${number_group}:" >> "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/group
		fi

		if [ -f "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/gshadow ]
		then
			echo "${name_group}:x:${number_group}:" >> "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/gshadow
		fi
	done

	# reset IFS

	IFS=''

	frobulator.complete

}

image_locale () {

	# set locale selection for container

	echo "LC_ALL=en_US.UTF-8" >> "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/environment
	echo "en_US.UTF-8 UTF-8" > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/locale.gen
	echo "LANG=en_US.UTF-8" > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/locale.conf

	frobulator.complete

}

image_network () {

	# generate network files

	# hostname

	cat <<- 'FILE' > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/hostname
	${HOSTNAME}
	FILE

	# hosts

	cat <<- 'FILE' > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/hosts
	# IPv4 #

	127.0.0.1	localhost.localdomain
	127.0.0.1	localhost

	# IPv6 #

	::1			localhost.localdomain
	::1			localhost
	::1			ip6-localhost
	::1			ip6-loopbak
	fe00::0		ip6-localnet
	fe00::0		ip6-mcastprefix
	ff02::1		ip6-allnodes
	ff02::2		ip6-allrouters
	ff02::3		ip6-allhosts
	FILE

	# nameserver

	cat <<- 'FILE' > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/resolv.conf
	nameserver 1.1.1.1
	nameserver 1.0.0.1
	FILE

	frobulator.complete

}

image_preload () {

	# generate libgcc/libc location and add to dynamic linker for preload

	library_preload=$(find "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/usr/lib -type f -iname "libgcc_s.so.1")

	# set preload

	cat <<- FILE > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/ld.so.preload
	${library_preload}
	FILE

	frobulator.complete

}

image_sources () {

	# generate sources file

	if [ "${name_distribution}" = "debian" ]
	then
		cat <<- FILE > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/sources.list
		deb     http://deb.debian.org/${name_distribution}                  ${codename_distribution}            main non-free-firmware
		deb-src http://deb.debian.org/${name_distribution}                  ${codename_distribution}            main non-free-firmware

		deb     http://security.debian.org/${name_distribution}-security    ${codename_distribution}-security   main non-free-firmware
		deb-src http://security.debian.org/${name_distribution}-security    ${codename_distribution}-security   main non-free-firmware

		deb     http://deb.debian.org/${name_distribution}                  ${codename_distribution}-updates    main non-free-firmware
		deb-src http://deb.debian.org/${name_distribution}                  ${codename_distribution}-updates    main non-free-firmware
		FILE
	fi

	if [ "${name_distribution}" = "ubuntu" ]
	then
		cat <<- FILE > "${PREFIX}"/cnt/"${name_distribution}"/"${version_distribution}"/etc/sources.list
		deb     http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}            main restricted universe multiverse
		deb-src http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}            main restricted universe multiverse

		deb     http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}-security   main restricted universe multiverse
		deb-src http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}-security   main restricted universe multiverse

		deb     http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}-updates    main restricted universe multiverse
		deb-src http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}-updates    main restricted universe multiverse

		deb     http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}-backports  main restricted universe multiverse
		deb-src http://archive.ubuntu.com/${name_distribution}              ${codename_distribution}-backports  main restricted universe multiverse

		deb     http://archive.canonical.com/${name_distribution}           ${codename_distribution}            partner
		deb-src http://archive.canonical.com/${name_distribution}           ${codename_distribution}            partner
		FILE
	fi

	frobulator.complete

}

if [ "${option}" = "image" ]
then
	# validate distribution name and version

	image_handle
fi

if [ "${option}" = "selection" ]
then
	unset name_distribution
	unset version_distribution
	unset codename_distribution

	# select image version

	image_select
fi

# verify architecture

architecture_image

# download image

image_download

# extract image into container directory

image_extract

# generate environment variables

image_environment

# generate environment locale

image_locale

# generate missing groups

# image_groups

# generate network

image_network

# generate preload entries

#image_preload

# generate sources entries

image_sources
