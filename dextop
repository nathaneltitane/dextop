purge_intent () {

	# uninstall desktop environment and dependencies

	yes | apt purge xfce* > "${sink}" 2>&1

	yes | apt clean > "${sink}" 2>&1

	# purge items loaded during dextop install

	items_list=(

		# files

		"${HOME}"/.hushlogin
		"${HOME}"/.config/gtk-3.0/bookmarks

		"${HOME}"/.local/bin/bash-aliases
		"${HOME}"/.local/bin/bash-configuration
		"${HOME}"/.local/bin/bash-configuration
		"${HOME}"/.local/bin/bash-functions
		"${HOME}"/.local/bin/bash-login
		"${HOME}"/.local/bin/bash-logout
		"${HOME}"/.local/bin/bash-profile

		"${HOME}"/.bash_aliases
		"${HOME}"/.bashrc
		"${HOME}"/.bash_configuration
		"${HOME}"/.bash_functions
		"${HOME}"/.bash_login
		"${HOME}"/.bash_logout
		"${HOME}"/.bash_profile

		# directories

		"${HOME}"/.dextop
		"${HOME}"/.icons
		"${HOME}"/.themes

		"${PREFIX%/*}"bin
		"${PREFIX%/*}"bkp
		"${PREFIX%/*}"cnt
		"${PREFIX%/*}"etc
		"${PREFIX%/*}"img
		"${PREFIX%/*}"lib
		"${PREFIX%/*}"mnt
		"${PREFIX%/*}"opt
		"${PREFIX%/*}"tmp
		"${PREFIX%/*}"media

		"${PREFIX}"/bkp
		"${PREFIX}"/cnt
		"${PREFIX}"/img
		"${PREFIX}"/mnt
		"${PREFIX}"/media
		"${PREFIX}"/storage

	)

	for item in ${items_list[@]}
	do
		frobulator.delete "${item}"
	done

}

# architecture check ///////////////////////////////////////////////////////////

frobulator.log "architecture_intent"

# options //////////////////////////////////////////////////////////////////////

if [ "${option}" = "initialize" ]
then
	frobulator.inf "Initializing" "[ Dextop ]"
	echo

	preferences_intent

	addons_intent

	utilities_intent

	shell_intent

	frobulator.cpt "Complete" "[ Initialize // Dextop ]"
	echo

	exit
fi

if [ "${option}" = "addons" ]
then
	frobulator.inf "Loading" "[ ${option} ]"
	echo

	addons_intent

	frobulator.cpt "Complete" "[ ${option} ]"
	echo

	exit
fi

if [ "${option}" = "additions" ]
then
	frobulator.inf "Loading" "[ ${option} ]"
	echo

	additions_intent

	frobulator.cpt "Complete" "[ ${option} ]"
	echo

	exit
fi

if [ "${option}" = "backup" ]
then
	frobulator.inf "Loading" "[ ${option} ]"
	echo

	backup_intent

	frobulator.cpt "Complete" "[ Backup // Dextop ]"
	echo

	exit
fi

if [ "${option}" = "update" ]
then
	if [[ "${update}" = [aA][lL][lL] ]]
	then
		update_item="all"

		frobulator.inf "Updating" "[ ${update} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		dextop_intent

		backgrounds_intent

		interface_intent

		utilities_intent

		additions_intent

		shell_intent

		"${HOME}"/.local/bin/termux-update

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [dD][eE][xX][tT][oO][pP] ]]
	then
		frobulator.inf "Updating" "[ ${update} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		dextop_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [aA][dD][dD][iI][tT][iI][oO][nN][sS] ]]
	then
		frobulator.inf "Updating" "[ ${update} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		additions_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [bB][aA][cK][gG][rR][oO][uU][nN][dD] ]]
	then

		frobulator.inf "Updating" "[ ${update_item} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		shell_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [iI][nN][tT][eE][rR][fF][aA][cC][eE] ]]
	then

		frobulator.inf "Updating" "[ ${update_item} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		interface_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [pP][rR][eE][fF][eE][rR][eE][nN][cC][eE][sS] ]]
	then

		frobulator.inf "Updating" "[ ${utility} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		preferences_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [sS][hH][eE][lL][lL] ]]
	then

		frobulator.inf "Updating" "[ ${update_item} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		shell_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	if [[ "${update}" = [tT][eE][rR][mM][uU][xX] ]]
	then
		frobulator.inf "Updating" "[ ${update} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		"${HOME}"/.local/bin/termux-update

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo

	fi

	if [[ "${update}" = [uU][tT][iI][lL][iI][tT][yY] ]]
	then

		frobulator.inf "Updating" "[ ${update_item} ]"
		echo

		frobulator.fwd "Updating${marker_elp}"
		echo

		utilities_intent

		frobulator.cpt "Complete" "[ Update // ${update} ]"
		echo
	fi

	exit
fi

if [ "${option}" = "purge" ]
then
	# notice

	frobulator.err "" "[ DISCLAIMER ]"
	echo

	frobulator.separate

	frobulator.wrn "'Purge' option has been selected:"
	frobulator.wrn "This action is permanent."
	echo

	frobulator.inf "All items loaded during the Dextop setup process will be PERMANENTLY REMOVED."
	frobulator.nul "Modifications made outside the intended installation process may cause instability or data corruption upon removal."
	echo

	frobulator.wrn "The author is not responsible for any damages or issues arising from the removal of Dextop."
	frobulator.nul "You have been warned."

	frobulator.separate

	frobulator.ask "Purge Dextop?"

	frobulator.read reply

	if [[ "${reply}" = [yY]         ]] || \
	   [[ "${reply}" = [yY][eE][sS] ]]
	then
		frobulator.fwd "Removal in progress${marker_elp}"
		echo

		purge_intent &

		frobulator.progress "purge"

	else
		frobulator.inf "Aborting" "[ ${option} ]"
		echo

		exit 1
	fi
fi

# setup ////////////////////////////////////////////////////////////////////////

if [ "${option}" = "setup"       ] || \
   [ "${option}" = "environment" ]
then
	if [ ! -f "${HOME}"/.dextop/dextop-setup-checkpoint ]
	then
		# dextop ///////////////////////////////////////////////////////////////

		# failsafe

		failsafe_intent &

		frobulator.process "Please wait"

		frobulator.complete "${HOME}"/.dextop dextop-failsafe-checkpoint

		# backup

		frobulator.complete "${HOME}"/.dextop dextop-backup-checkpoint backup_intent

		# preferences

		frobulator.complete "${HOME}"/.dextop dextop-preferences-checkpoint preferences_intent

		#  utilities

		frobulator.complete "${HOME}"/.dextop dextop-utilities-checkpoint utilities_intent

		# directories

		frobulator.complete "${HOME}"/.dextop dextop-directories-checkpoint directories_intent

		# additions

		frobulator.complete "${HOME}"/.dextop dextop-additions-checkpoint additions_intent

		# backgrounds

		frobulator.complete "${HOME}"/.dextop dextop-backgrounds-checkpoint backgrounds_intent

		# automatic login

		if [ ! -f "${HOME}"/.dextop/dextop-login-checkpoint ]
		then
			frobulator.write login "${HOME}"/.dextop dextop-login

			frobulator.file "${HOME}"/.dextop dextop-login-checkpoint
		fi

		# automatic logout

		if [ ! -f "${HOME}"/.dextop/dextop-logout-checkpoint ]
		then
			frobulator.write logout "${HOME}"/.dextop dextop-logout

			frobulator.file "${HOME}"/.dextop dextop-logout-checkpoint
		fi

		# automatic update

		if [ ! -f "${HOME}"/.dextop/dextop-update-checkpoint ]
		then
			frobulator.file "${HOME}"/.dextop dextop-update

			frobulator.file "${HOME}"/.dextop dextop-update-checkpoint
		fi

		# audio

		if [ ! -f "${HOME}"/.dextop/dextop-audio-checkpoint ]
		then
			frobulator.file "${HOME}"/.dextop dextop-audio

			frobulator.file "${HOME}"/.dextop dextop-audio-checkpoint
		fi

		# ticker

		if [ ! -f "${HOME}"/.dextop/dextop-ticker-checkpoint ]
		then
			frobulator.write 0 "${HOME}"/.dextop dextop-ticker

			frobulator.file "${HOME}"/.dextop dextop-ticker-checkpoint
		fi

		# termux ///////////////////////////////////////////////////////////////

		# termux addons

		frobulator.complete "${HOME}"/.dextop dextop-termux-addons-checkpoint "${HOME}"/.local/bin/termux-addons

		# termux storage

		frobulator.complete "${HOME}/.dextop" dextop-termux-storage-checkpoint storage_intent

		# termux packages

		frobulator.complete "${HOME}"/.dextop dextop-termux-packages-checkpoint "${HOME}"/.local/bin/termux-packages

		# container ////////////////////////////////////////////////////////////

		# container image

		frobulator.complete "${HOME}"/.dextop dextop-container-image-checkpoint "${HOME}"/.local/bin/container-image

		# container expansion

		frobulator.complete "${HOME}"/.dextop dextop-container-expansion-checkpoint container_intent "${HOME}"/.local/bin/container-expansion

		# container packages

		frobulator.complete "${HOME}"/.dextop dextop-container-packages-checkpoint container_intent "${HOME}"/.local/bin/container-packages

		# container user

		frobulator.complete "${HOME}"/.dextop dextop-container-user-checkpoint container_intent "${HOME}"/.local/bin/container-user

		# dextop ///////////////////////////////////////////////////////////////

		# shell

		frobulator.complete "${HOME}"/.dextop dextop-shell-checkpoint shell_intent

		# bookmarks

		frobulator.complete "${HOME}"/.dextop dextop-bookmarks-checkpoint bookmarks_intent

		# interface

		frobulator.complete "${HOME}"/.dextop dextop-interface-checkpoint interface_intent

		# icons

		frobulator.complete "${HOME}"/.dextop dextop-icons-checkpoint icons_intent

		# themes

		frobulator.complete "${HOME}"/.dextop dextop-themes-checkpoint themes_intent

		# setup move

		frobulator.complete "${HOME}"/.dextop dextop-move-checkpoint frobulator.move "${HOME}" "${HOME}"/.local/bin dextop

		# setup checkpoint

		frobulator.file "${HOME}"/.dextop dextop-setup-checkpoint
	fi

	# result ///////////////////////////////////////////////////////////////////

	frobulator.result "${HOME}"/.dextop dextop-setup-checkpoint "dextop setup"
	echo

	frobulator.timeout 5

	# clear ////////////////////////////////////////////////////////////////////

	frobulator.clear

	# session //////////////////////////////////////////////////////////////////

	session_intent

fi
