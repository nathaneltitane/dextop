intent_directories () {

	# generate dextop required directories

	directories_list+=(
		bkp
		cnt
		img
		mnt
		media
		storage
	)

	frobulator.directory "${PREFIX}" ${directories_list[@]}

	directories_list=()

	# generate root directory structure

	directories_list+=(
		bin
		bkp
		cnt
		etc
		img
		lib
		mnt
		opt
		tmp
		media
	)

	for directory in ${directories_list[@]}
	do
		frobulator.link "${PREFIX}" "${PREFIX%/*}" "${directory}"
	done

	directories_list=()

}

