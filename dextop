#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-c|--console)
			option="environment"
			environment="console"
		;;

		-e|--environment)
			option="environment"
			environment="${2}"

			shift
		;;

		-t|--termux)
			option="termux"
		;;

		-n|--container)
			option="container"
		;;

		-l|--link)
			option="link"
		;;

		-i|--initialize)
			option="initialize"
		;;

		-b|--backup)
			option="backup"
		;;

		-u|--update)
			option="update"
			update="${2}"

			if [ "${update}" = "background"  ] ||
			   [ "${update}" = "interface"   ] ||
			   [ "${update}" = "utility"     ] ||
			   [ "${update}" = "shell"       ] ||
			   [ "${update}" = "preferences" ]
			then
				item_update="${3}"

				shift
			fi

			shift

		;;

		-a|--addons)
			option="addons"
		;;

		-d|--additions)
			option="additions"
		;;

		-p|--purge)
			option="purge"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -c | -e [Environment] | -t | -n | -l | -i | -a | -d | -b | -u [Update] [Name] | -p | -h [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-c, --console        Set up [c]onsole access to environment and utilities only."
			echo
			echo -e "-e, --environment    Set up desktop [e]nvironment and utilities."
			echo
			echo -e "                     [ i3 ]"
			echo -e "                     [ xfce ]    [ Default  ]"
			echo -e "                     [ console ] [ Fallback ]"
			echo
			echo -e "-t, --termux         Set up [t]ermux environment and utilities only."
			echo
			echo -e "-n, --container      Set up co[n]tainer environment and utilities only."
			echo
			echo -e "-l, --link           Create [l]inks to unify storage directories."
			echo
			echo -e "-i, --initialize     Run [i]nitialization of setup directories and load configurations."
			echo
			echo -e "-a, --addons         Set up Termux [a]ddons and companion applications."
			echo
			echo -e "-d, --additions      Set up Dextop a[d]ditions."
			echo
			echo -e "-b, --backup         Create [b]ackup of termux user configuration files."
			echo
			echo -e "-u, --update         Run [u]pdate of application packages and utilities."
			echo
			echo -e "                     [ all ]"
			echo -e "                     [ dextop ]      [ Default ]"
			echo -e "                     [ additions ]"
			echo -e "                     [ background ]"
			echo -e "                     [ interface ]"
			echo -e "                     [ preferences ]"
			echo -e "                     [ shell ]"
			echo -e "                     [ termux ]"
			echo -e "                     [ utility ]"
			echo
			echo -e "-p, --purge          Run [p]urge of setup components and packages."
			echo
			echo -e "-h, --help           Show [h]elp and usage information."
			echo
			echo -e "'${script}'          [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -c | -e [Environment] | -t | -n | -l | -i | -a | -d | -b | -u [Update] [Name] | -p | -h [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# clear ────────────────────────────────────────────────────────────────────────

frobulator.clear

# variables ────────────────────────────────────────────────────────────────────

stamp=$(date +"%m-%d-%Y-%H-%M-%S")

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="setup"
fi

if [ -z "${container}" ]
then
	container="${PREFIX}"/cnt/debian/12

	frobulator.write write "${container}" "${HOME}"/.dextop dextop-container
fi

if [ "${option}" = "setup"       ] ||
   [ "${option}" = "environment" ]
then
	if [[ -z "${environment}" ]]
	then
		environment="xfce"

	elif [[ "${environment}" = [iI][3] ]]
	then
		environment="i3"

	elif [[ "${environment}" = [xX][fF][cC][eE] ]]
	then
		environment="xfce"

	elif [[ "${environment}" = [cC][oO][nN][sS][oO][lL][eE] ]]
	then
		environment="console"
	else
		frobulator.err "Unrecognized environment" "[ '${environment}' ]"

		frobulator.stp "Aborting${marker_elp}"

		exit 1
	fi

	if [ ! -f "${HOME}"/.dextop/dextop-environment ]
	then
		frobulator.write write "${environment}" "${HOME}"/.dextop dextop-environment

		unset environment
	fi
fi

if [ ! -f "${HOME}"/.dextop/dextop-session ]
then
	if [ -z "${session}" ]
	then
		# desktop environment chosen at setup: console / i3 / xfce

		name_environment="$(cat "${HOME}"/.dextop/dextop-environment)"

		if [ "${name_environment}" = "i3" ]
		then
			session="i3"
		fi

		if [ "${name_environment}" = "xfce" ]
		then
			session="xfce4-session"
		fi

		if [ "${name_environment}" = "console" ]
		then
			session="console"
		fi

		frobulator.write write "${session}" "${HOME}"/.dextop dextop-session

		unset session
	fi
fi

# functions ────────────────────────────────────────────────────────────────────

container_environment () {

	# generate container environment

	CONTAINER_ROOT="${PREFIX}"/cnt/debian/12

	# set path:
	# in order of retreival

	CONTAINER_PATH=""

	# container

	[ -d "${CONTAINER_ROOT}"/usr/local/sbin ] && CONTAINER_PATH+="/usr/local/sbin:"
	[ -d "${CONTAINER_ROOT}"/usr/local/bin ]  && CONTAINER_PATH+="/usr/local/bin:"
	[ -d "${CONTAINER_ROOT}"/usr/sbin ]       && CONTAINER_PATH+="/usr/sbin:"
	[ -d "${CONTAINER_ROOT}"/usr/sbin ]       && CONTAINER_PATH+="/usr/bin:"
	[ -d "${CONTAINER_ROOT}"/sbin ]           && CONTAINER_PATH+="/sbin:"
	[ -d "${CONTAINER_ROOT}"/bin ]            && CONTAINER_PATH+="/bin:"

	# termux

	[ -d "${HOME}"/.local/bin ]               && CONTAINER_PATH+="${HOME}/.local/bin:"

	[ -d "${PREFIX}"/sbin ]                   && CONTAINER_PATH+="${PREFIX}/sbin:"
	[ -d "${PREFIX}"/bin ]                    && CONTAINER_PATH+="${PREFIX}/bin:"

	CONTAINER_PATH="${CONTAINER_PATH}"

	export CONTAINER_ROOT="${CONTAINER_ROOT}"
	export CONTAINER_PATH="${CONTAINER_PATH}"

	return
}

container_intent () {

	# run container setup commands through 'proot'

	TERMUX_ROOT="${PREFIX%/*}"
	TERMUX_HOME="${TERMUX_ROOT}"/home

	CONTAINER_HOME="${CONTAINER_ROOT}"/home

	USER_ID="0"
	GROUP_ID="0"

	# assume 'termux-exec' is installed

	unset LD_PRELOAD

	# generate container environment

	container_environment

	# run using default system parameters:
	# mitigate errors and path interpretation issues during container setup

	proot																\
		--kill-on-exit													\
		--link2symlink													\
		--rootfs="${CONTAINER_ROOT}"									\
		--change-id="${USER_ID}":${GROUP_ID}							\
		--pwd="${CONTAINER_HOME}"										\
		--bind=/apex:/apex												\
		--bind=/linkerconfig/ld.config.txt:/linkerconfig/ld.config.txt	\
		--bind=/data:/data												\
		--bind=/dev:/dev												\
		--bind=/dev/urandom:/dev/random									\
		--bind=/proc:/proc												\
		--bind=/proc/self/fd:/dev/fd									\
		--bind=/proc/self/fd/0:/dev/stdin								\
		--bind=/proc/self/fd/1:/dev/stdout								\
		--bind=/proc/self/fd/2:/dev/stderr								\
		--bind=/storage:/storage										\
		--bind=/sys:/sys												\
		--bind=/system:/system											\
		--bind=/vendor:/vendor											\
		--bind="${TERMUX_HOME}":"${CONTAINER_HOME}"						\
			/usr/bin/env 												\
				--ignore-environment									\
					ANDROID_ART_ROOT="${ANDROID_ART_ROOT}"				\
					ANDROID_DATA="${ANDROID_DATA}"						\
					ANDROID_I18N_ROOT="${ANDROID_I18N_ROOT}"			\
					ANDROID_ROOT="${ANDROID_ROOT}"						\
					ANDROID_RUNTIME_ROOT="${ANDROID_RUNTIME_ROOT}"		\
					ANDROID_TZDATA_ROOT="${ANDROID_TZDATA_ROOT}"		\
					BOOTCLASSPATH="${BOOTCLASSPATH}"					\
					DEX2OATBOOTCLASSPATH="${DEX2OATBOOTCLASSPATH}"		\
					PREFIX="${PREFIX}"									\
					TERM="${TERM}"										\
					TMPDIR="${TMPDIR}"									\
					COLORTERM="${COLORTERM}"							\
					LANG="${LANG}"										\
					HOME="${CONTAINER_HOME}"							\
					PATH="${CONTAINER_PATH}"							\
																		${@}
}

intent_failsafe () {

	# ref.: https://github.com/termux/termux-packages/issues/10871

	# run failsafe termux package and repository update:
	# mitigate general deployment setup issues
	# mitigate skipped packages on install

	yes | apt update            > "${sink}" 2>&1

	yes | apt full-upgrade      > "${sink}" 2>&1

	yes | apt install root-repo > "${sink}" 2>&1

	yes | apt install x11-repo  > "${sink}" 2>&1

}

intent_architecture () {

	local architecture

	# list supported processor architectures

	list_architectures_cpu=(
		aarch64
		"arm*"
		amd64
		"i*86"
		x86_64
	)

	# test processor architecture string

	architecture_device="$(uname -m)"

	for architecture in "${list_architectures_cpu[@]}"
	do
		if [[ "${architecture_device}" == ${architecture} ]]
		then
			frobulator.scs "Supported device architecture" "[ ${architecture_device} ]"

			return 0
		fi
	done

	return 1
}

intent_update () {

	# handle updates

	url_update="${1}"
	directory_update="${2}"
	list_items_update=(${@:3})

	if [[ "${item_update}" = "all" ]]
	then
		list_files_update=(${list_items_update[@]})

		frobulator.download "${url_update}" "${directory_update}" ${list_files_update[@]}

	elif [[ ${list_items_update[@]} =~ "${item_update}" ]]
	then
		list_files_update=("${item_update}")

		frobulator.download "${url_update}" "${directory_update}" "${item_update}"

	elif  [[ ! ${list_items_update[@]} =~ "${item_update}" ]]
	then
		list_files_update=(${@:3})

		frobulator.err "Unknown item name" "[ '${item_update}' ]"

		frobulator.fwd "Listing known items${marker_elp}"

		frobulator.timeout

		IFS=$'\n'

		printf "${marker_nul} %s\n" ${list_files_update[@]}

		echo

		IFS=''

		frobulator.msg "Review item name spelling and try again."

		frobulator.inf "Update all known items using 'all' argument."

		exit 1
	fi

	list_files_update=()

}

intent_reload () {

	# termux settings reload:
	# update command line interface with dextop settings

	command_settings=()

	command_settings+=(am broadcast)
	command_settings+=(--user 0)
	command_settings+=(-a com.termux.app.reload_style)
	command_settings+=(-p com.termux)

	frobulator.silence "${command_settings[@]}"

}

intent_backup () {

	# handle user home directory backup

	name_backup="dextop-backup"
	extension_backup="tar.gz"

	directory_backup="${HOME}"

	file_backup="${name_backup}-${stamp}.${extension_backup}"

	frobulator.inf "Generating backup" "[ ${file_backup} ]"

	tar																\
		--create													\
		--gzip														\
			--exclude="${name_backup}"*								\
				--file="${directory_backup}"/"${file_backup}"	\
																	"${directory_backup}" > "${sink}" 2>&1 &

	frobulator.progress "archive" "[ ${directory_backup} ]"

}

intent_dextop () {

	# load dextop deployment script

	frobulator.download get.dxtp.app "${HOME}"/.local/bin dextop
}

intent_addons () {

	# termux addons and companion applications

	"${HOME}"/.local/bin/termux-addons

}

intent_additions () {

	# load additions files

	list_additions+=(
		dextop-additions
	)

	if [[ "${option}" = "update" ]]
	then
		intent_update get.dxtp.app "${HOME}"/.local/bin ${list_additions[@]}
	else
		frobulator.download get.dxtp.app "${HOME}"/.local/bin ${list_additions[@]}
	fi

	list_additions=()

}

intent_storage () {

	# select stoarge command option

	if [ "${option}" = "link" ]
	then
		"${HOME}/.local/bin/termux-storage" -l
	else
		"${HOME}/.local/bin/termux-storage"
	fi

}

intent_backgrounds () {

	# load background files

	list_backgrounds=(
		dextop-black.png
		dextop-black.svg
		dextop-blue.png
		dextop-blue.svg
		dextop-canary.png
		dextop-canary.svg
		dextop-coral.png
		dextop-coral.svg
		dextop-grey.png
		dextop-grey.svg
		dextop-sky.png
		dextop-sky.svg
		dextop-violet.png
		dextop-violet.svg
	)

	if [[ "${option}" = "update" ]]
	then
		intent_update get.dxtp.app "${HOME}"/.dextop ${list_backgrounds[@]}
	else
		frobulator.download get.dxtp.app "${HOME}"/.dextop ${list_backgrounds[@]}
	fi

	list_backgrounds=()

}

intent_interface () {

	# load interface files

	list_interface+=(
		i3-configuration
		i3status-configuration
		i3-backgrounds
		i3-confirm
		i3-directory
		i3-exit
		i3-file
		i3-file-manager
		i3-launch
		i3-lookup
		i3-manual
		i3-navigation
		i3-notes
		i3-processes
		i3-shortcuts
		i3-status
		i3-template
	)

	if [[ "${option}" = "update" ]]
	then
		intent_update get.trmnl.me "${HOME}"/.local/bin ${list_interface[@]}
	else
		frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list_interface[@]}

		if [ -z "${option}" ] || [ "${option}" = "termux" ]
		then
			# link configuration files

			frobulator.link "${HOME}"/.local/bin "${HOME}"/.config/i3          i3-configuration          config
			frobulator.link "${HOME}"/.local/bin "${HOME}"/.config/i3status    i3status-configuration    config
		fi

	fi

	list_interface=()

}

intent_preferences () {

	# termux preferences and properties

	list_preferences+=(
		termux-colors
		termux-font-hack
		termux-properties
		termux-reload-settings
	)

	if [[ "${option}" = "update" ]]
	then
		intent_update get.dxtp.app "${HOME}"/.local/bin ${list_preferences[@]}
	else
		frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list_preferences[@]}

		frobulator.link "${HOME}"/.local/bin "${HOME}"/.termux termux-colors     colors.properties
		frobulator.link "${HOME}"/.local/bin "${HOME}"/.termux termux-font-hack       font.ttf
		frobulator.link "${HOME}"/.local/bin "${HOME}"/.termux termux-properties termux.properties

		intent_reload
	fi

	list_preferences=()

}

intent_shell () {

	# load shell files

	list_shell+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	if [[ "${option}" = "update" ]]
	then
		intent_update get.trmnl.me "${HOME}"/.local/bin ${list_shell[@]}
	else
		frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list_shell[@]}

		# link to user home

		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-aliases       .bash_aliases
		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-configuration .bashrc
		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-configuration .bash_configuration
		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-functions     .bash_functions
		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-login         .bash_login
		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-logout        .bash_logout
		frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-profile       .bash_profile

		frobulator.file "${HOME}" .hushlogin

		if [[ "${option}" = "setup"      ]] ||
		   [[ "${option}" = "container"  ]] ||
		   [[ "${option}" = "initialize" ]]
		then
			CONTAINER_ROOT=$(cat "${HOME}"/.dextop/dextop-container)

			# link to root home

			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-aliases       .bash_aliases
			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-configuration .bashrc
			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-configuration .bash_configuration
			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-functions     .bash_functions
			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-login         .bash_login
			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-logout        .bash_logout
			frobulator.link "${HOME}"/.local/bin "${CONTAINER_ROOT}"/root bash-profile       .bash_profile

			frobulator.file "${CONTAINER_ROOT}"/root .hushlogin
		fi
	fi

	list_shell=()

}

intent_utilities () {

	# load dextop utilities

	list_utilities+=(
		termux-packages
		termux-update
		termux-storage
		termux-addons
		container-expansion
		container-image
		container-initialization
		container-packages
		container-session
		container-settings
		container-user
	)

	if [[ "${option}" = "update" ]]
	then
		intent_update get.dxtp.app "${HOME}"/.local/bin ${list_utilities[@]}
	else
		frobulator.download get.dxtp.app "${HOME}"/.local/bin ${list_utilities[@]}
	fi

	list_utilities=()

}

intent_directories () {

	# generate dextop required directories

	list_directories+=(
		bkp
		cnt
		img
		mnt
		media
		storage
	)

	frobulator.directory "${PREFIX}" ${list_directories[@]}

	list_directories=()

	# generate root directory structure

	list_directories+=(
		bin
		bkp
		cnt
		etc
		img
		lib
		mnt
		opt
		tmp
		media
	)

	for directory in ${list_directories[@]}
	do
		frobulator.link "${PREFIX}" "${PREFIX%/*}" "${directory}"
	done

	list_directories=()

}

intent_bookmarks () {

	# generate file browser bookmarks

	list_directories_bookmarks=(
		"${PREFIX}"/cnt
		"${PREFIX}"/media/[aA]ndroid
		"${PREFIX}"/media/[eE]xternal
		"${PREFIX}"/media/[iI]nternal
	)

	list_labels_bookmarks=(
		Container
		Android
		External
		Internal
	)

	for (( index=0 ; index<${#list_directories_bookmarks[@]} ; index++ ))
	do
		if [ -d ${list_directories_bookmarks[$index]} ]
		then
			frobulator.write append "file://${list_directories_bookmarks[$index]} ${list_labels_bookmarks[$index]}" "${HOME}"/.config/gtk-3.0 bookmarks
		fi
	done

	list_directories_bookmarks=()

	list_labels_bookmarks=()

}

intent_icons () {

	# link icons theme directories

	frobulator.link "${PREFIX}"/share "${HOME}" icons .icons

	# select icon themes

	list_icons+=(
		Adwaita
		Papirus
		Papirus-Dark
		Papirus-Light
		default
		hicolor
	)

	# keep icon theme selections

	frobulator.keep "${HOME}"/.icons ${list_icons[@]}

	list_icons=()

}

intent_themes () {

	CONTAINER_ROOT="${PREFIX}"/cnt/debian/12

	# link theme directories

	frobulator.link "${CONTAINER_ROOT}"/usr/share "${HOME}" themes .themes

	# select themes

	list_themes+=(
		Arc
		Arc-Dark
		Arc-Darker
		Arc-Lighter
	)

	# keep theme selections

	frobulator.keep "${HOME}"/.themes ${list_themes[@]}

	list_themes=()

}

intent_session () {

	# start session

	cd "${HOME}"

	"${PREFIX}"/bin/login

}

intent_purge () {

	# uninstall desktop environment and dependencies

	yes | apt purge xfce* > "${sink}" 2>&1

	yes | apt clean > "${sink}" 2>&1

	# purge items loaded during dextop install

	list_items=(

		# files

		"${HOME}"/.hushlogin
		"${HOME}"/.config/gtk-3.0/bookmarks

		"${HOME}"/.local/bin/bash-aliases
		"${HOME}"/.local/bin/bash-configuration
		"${HOME}"/.local/bin/bash-configuration
		"${HOME}"/.local/bin/bash-functions
		"${HOME}"/.local/bin/bash-login
		"${HOME}"/.local/bin/bash-logout
		"${HOME}"/.local/bin/bash-profile

		"${HOME}"/.bash_aliases
		"${HOME}"/.bashrc
		"${HOME}"/.bash_configuration
		"${HOME}"/.bash_functions
		"${HOME}"/.bash_login
		"${HOME}"/.bash_logout
		"${HOME}"/.bash_profile

		# directories

		"${HOME}"/.dextop
		"${HOME}"/.icons
		"${HOME}"/.themes

		"${PREFIX%/*}"bin
		"${PREFIX%/*}"bkp
		"${PREFIX%/*}"cnt
		"${PREFIX%/*}"etc
		"${PREFIX%/*}"img
		"${PREFIX%/*}"lib
		"${PREFIX%/*}"mnt
		"${PREFIX%/*}"opt
		"${PREFIX%/*}"tmp
		"${PREFIX%/*}"media

		"${PREFIX}"/bkp
		"${PREFIX}"/cnt
		"${PREFIX}"/img
		"${PREFIX}"/mnt
		"${PREFIX}"/media
		"${PREFIX}"/storage

	)

	for item in ${list_items[@]}
	do
		frobulator.delete "${item}"
	done

}

# architecture check ───────────────────────────────────────────────────────────

intent_architecture

frobulator.complete halt "Unsupported device architecture" "[ ${architecture_device} ]"

# options ──────────────────────────────────────────────────────────────────────

if [ "${option}" = "initialize" ]
then
	frobulator.inf "Initializing" "[ Dextop ]"

	intent_preferences

	intent_addons

	intent_utilities

	intent_shell

	frobulator.cpt "Complete" "[ Initialize // Dextop ]"

	exit
fi

if [ "${option}" = "addons" ]
then
	frobulator.inf "Loading" "[ ${option} ]"

	intent_addons

	frobulator.cpt "Complete" "[ ${option} ]"

	exit
fi

if [ "${option}" = "additions" ]
then
	frobulator.inf "Loading" "[ ${option} ]"

	intent_additions

	frobulator.cpt "Complete" "[ ${option} ]"

	exit
fi

if [ "${option}" = "backup" ]
then
	frobulator.inf "Loading" "[ ${option} ]"

	intent_backup

	frobulator.cpt "Complete" "[ Backup // Dextop ]"

	exit
fi

if [ "${option}" = "update" ]
then
	if [[ "${update}" = [aA][lL][lL] ]]
	then
		item_update="all"

		frobulator.inf "Updating" "[ ${update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_dextop

		intent_backgrounds

		intent_interface

		intent_utilities

		intent_additions

		intent_shell

		"${HOME}"/.local/bin/termux-update

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [dD][eE][xX][tT][oO][pP] ]]
	then
		frobulator.inf "Updating" "[ ${update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_dextop

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [aA][dD][dD][iI][tT][iI][oO][nN][sS] ]]
	then
		frobulator.inf "Updating" "[ ${update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_additions

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [bB][aA][cK][gG][rR][oO][uU][nN][dD] ]]
	then

		frobulator.inf "Updating" "[ ${item_update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_shell

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [iI][nN][tT][eE][rR][fF][aA][cC][eE] ]]
	then

		frobulator.inf "Updating" "[ ${item_update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_interface

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [pP][rR][eE][fF][eE][rR][eE][nN][cC][eE][sS] ]]
	then

		frobulator.inf "Updating" "[ ${utility} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_preferences

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [sS][hH][eE][lL][lL] ]]
	then

		frobulator.inf "Updating" "[ ${item_update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_shell

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	if [[ "${update}" = [tT][eE][rR][mM][uU][xX] ]]
	then
		frobulator.inf "Updating" "[ ${update} ]"

		frobulator.fwd "Updating${marker_elp}"

		"${HOME}"/.local/bin/termux-update

		frobulator.cpt "Complete" "[ Update // ${update} ]"

	fi

	if [[ "${update}" = [uU][tT][iI][lL][iI][tT][yY] ]]
	then

		frobulator.inf "Updating" "[ ${item_update} ]"

		frobulator.fwd "Updating${marker_elp}"

		intent_utilities

		frobulator.cpt "Complete" "[ Update // ${update} ]"
	fi

	exit
fi

if [ "${option}" = "purge" ]
then
	# notice

	frobulator.ntf err "[ DISCLAIMER ] 'Purge' option has been selected" "This action is permanent.${NLN}${NLN}All items loaded during the Dextop setup process will be PERMANENTLY REMOVED.${NLN}Modifications made outside the intended installation process may cause instability or data corruption upon removal.${NLN}${NLN}The author is not responsible for any damages or issues arising from the removal of Dextop.${NLN}${NLN}You have been warned."

	frobulator.qst "Purge Dextop?"

	frobulator.read reply

	if [[ "${reply}" = [yY]         ]] ||
	   [[ "${reply}" = [yY][eE][sS] ]]
	then
		frobulator.fwd "Removal in progress${marker_elp}"

		intent_purge &

		frobulator.progress "purge"

	else
		frobulator.inf "Aborting" "[ ${option} ]"

		exit 1
	fi
fi

# setup ────────────────────────────────────────────────────────────────────────

if [ "${option}" = "setup"       ] ||
   [ "${option}" = "environment" ]
then
	if [ ! -f "${HOME}"/.dextop/dextop-setup-checkpoint ]
	then
		# dextop ───────────────────────────────────────────────────────────────

		# failsafe

		intent_failsafe &

		frobulator.process "Please wait"

		frobulator.complete halt "Failsafe failed"

		# backup

		frobulator.complete "${HOME}"/.dextop dextop-backup-checkpoint intent_backup

		# preferences

		frobulator.complete "${HOME}"/.dextop dextop-preferences-checkpoint intent_preferences

		#  utilities

		frobulator.complete "${HOME}"/.dextop dextop-utilities-checkpoint intent_utilities

		# directories

		frobulator.complete "${HOME}"/.dextop dextop-directories-checkpoint intent_directories

		# additions

		frobulator.complete "${HOME}"/.dextop dextop-additions-checkpoint intent_additions

		# backgrounds

		frobulator.complete "${HOME}"/.dextop dextop-backgrounds-checkpoint intent_backgrounds

		# automatic login

		frobulator.complete "${HOME}"/.dextop dextop-login-checkpoint frobulator.write write login "${HOME}"/.dextop dextop-login

		# automatic logout

		frobulator.complete "${HOME}"/.dextop dextop-logout-checkpoint frobulator.write write logout "${HOME}"/.dextop dextop-logout

		# automatic update

		frobulator.complete "${HOME}"/.dextop dextop-update-checkpoint frobulator.file "${HOME}"/.dextop dextop-update

		# audio

		frobulator.complete "${HOME}"/.dextop dextop-audio-checkpoint frobulator.file "${HOME}"/.dextop dextop-audio

		# ticker

		frobulator.complete "${HOME}"/.dextop dextop-ticker-checkpoint frobulator.write write 0 "${HOME}"/.dextop dextop-ticker

		# termux ───────────────────────────────────────────────────────────────

		# termux addons

		frobulator.complete "${HOME}"/.dextop dextop-termux-addons-checkpoint "${HOME}"/.local/bin/termux-addons

		# termux storage

		frobulator.complete "${HOME}/.dextop" dextop-termux-storage-checkpoint intent_storage

		# termux packages

		frobulator.complete "${HOME}"/.dextop dextop-termux-packages-checkpoint "${HOME}"/.local/bin/termux-packages

		# container ────────────────────────────────────────────────────────────

		# container image

		frobulator.complete halt "${HOME}"/.dextop dextop-container-image-checkpoint "${HOME}"/.local/bin/container-image

		# container expansion

		frobulator.complete "${HOME}"/.dextop dextop-container-expansion-checkpoint container_intent "${HOME}"/.local/bin/container-expansion

		# container packages

		frobulator.complete "${HOME}"/.dextop dextop-container-packages-checkpoint container_intent "${HOME}"/.local/bin/container-packages

		# container user

		frobulator.complete "${HOME}"/.dextop dextop-container-user-checkpoint container_intent "${HOME}"/.local/bin/container-user

		# dextop ───────────────────────────────────────────────────────────────

		# shell

		frobulator.complete "${HOME}"/.dextop dextop-shell-checkpoint intent_shell

		# bookmarks

		frobulator.complete "${HOME}"/.dextop dextop-bookmarks-checkpoint intent_bookmarks

		# interface

		frobulator.complete "${HOME}"/.dextop dextop-interface-checkpoint intent_interface

		# icons

		frobulator.complete "${HOME}"/.dextop dextop-icons-checkpoint intent_icons

		# themes

		frobulator.complete "${HOME}"/.dextop dextop-themes-checkpoint intent_themes

		# setup move

		frobulator.complete "${HOME}"/.dextop dextop-move-checkpoint frobulator.move "${HOME}" "${HOME}"/.local/bin dextop

	fi

	# result and setup checkpoint: written only when every step succeeded

	# 'frobulator.result' is the checkpoint command:
	# returns success only when every step passed

	frobulator.complete "${HOME}"/.dextop dextop-setup-checkpoint frobulator.result "dextop setup"

	frobulator.timeout 5

	# clear ────────────────────────────────────────────────────────────────────

	frobulator.clear

	# session ──────────────────────────────────────────────────────────────────

	intent_session

fi
