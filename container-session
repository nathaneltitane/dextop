# functions ────────────────────────────────────────────────────────────────────

container_parse () {

	# parse container directories

	for directory_distribution in "${CONTAINER_BASE}"/*
	do
		for version_entry in "${directory_distribution}"/*
		do
			name_distribution=$(basename ${directory_distribution})

			version_distribution=$(basename ${version_entry})

			list_containers+=(${name_distribution} ${version_distribution})
		done
	done

	if [[ ${#CONTAINER_ROOT[@]} -eq 1 ]]
	then
		name_distribution="${name_distribution}"
		version_distribution="${version_distribution}"

		frobulator.inf "Single container found" "[ ${name_distribution} // ${version_distribution} ]"

		frobulator.fwd "Proceeding${marker_elp}"
	fi

	if [[ ${#CONTAINER_ROOT[@]} -ge 2 ]]
	then
		frobulator.ipt "Select one of the following containers:"
		echo

		# set padding for uniform output

		length_pad=10

		# normalize output

		echo

		# continue list using array selection of suppported values

		for (( index_entry = 0 ; index_entry < ${#list_containers[@]} ; index_entry += 2 ))
		do
			number_entry=$(( ( ${index_entry} / 2 ) + 1 ))

			name_entry="${list_containers[${index_entry}]}"
			version_entry="${list_containers[${index_entry}+1]}"

			indent="${marker_tab}"

			if [ ${#version_entry} -le 2 ]
			then
				indent+="${marker_tab}"
			fi

			if (( ${index_entry} / 2 >= 0 && ${index_entry} / 2 <= 8 ))
			then
				# handle number spacing for entries 1-9

				number_entry=" ${number_entry}"
			else
				# handle number spacing for entries 10+

				number_entry="${number_entry}"
			fi

			# list container entries

			echo "${marker_nul}" "[ ${number_entry} ]" "${name_entry}" "${version_entry}"

		done

		echo

		# values #

		list_values=(
			selection
		)

		# handle user input for list_values

		eval ${frobulator_return[@]}

		frobulator.ipt "Selection:"

		frobulator.read selection

		# integer check:
		# handle numerical selection

		while [[ "${selection}" -lt 1           ]] ||
			  [[ "${selection}" -gt "${number_entry}" ]] ||
			  [[ ! "${selection}" =~ ^[0-9]+$   ]]
		do
			echo
			frobulator.err "Invalid selection:"

			frobulator.wrn "Select container [ 1 - ${number_entry} ]"

			frobulator.ipt "Selection:"

			frobulator.read selection

		done

		# parse selection parameters

		index_entry=$(( ${selection} ))
		index_entry=$(( ${index_entry} * 2 ))

		name_entry="${list_containers[index_entry-2]}"
		version_entry="${list_containers[index_entry-1]}"

		name_distribution="${name_entry}"
		version_distribution="${version_entry}"

	fi

	# unset array

	list_containers=()

	# specify distribution selection variables

	name_distribution="${name_entry}"
	version_distribution="${version_entry}"

	CONTAINER_ROOT="${CONTAINER_BASE}"/"${name_distribution}"/"${version_distribution}"

	# specify directory_container for container input handling

	directory_container="${CONTAINER_BASE}"
}

container_input () {

	# no container root specified

	if [ -z "${directory_container}" ]
	then
		CONTAINER_BASE="${PREFIX}"/cnt
		CONTAINER_ROOT=("${CONTAINER_BASE}"/*/*)

		directory_container=("${CONTAINER_ROOT}")

		frobulator.wrn "Container directory not specified."

		container_parse
	fi

	# user specified invalid container root

	if [ ! -e "${directory_container}" ]
	then
		CONTAINER_BASE="${PREFIX}"/cnt
		CONTAINER_ROOT=("${CONTAINER_BASE}"/*/*)

		frobulator.err "Container directory not found."

		container_parse
	fi

	# user specified container root exists

	if [ -d "${directory_container}" ]
	then
		CONTAINER_BASE="${directory_container}"
		CONTAINER_ROOT=("${CONTAINER_BASE}"/*/*)

		frobulator.scs "Container directory found."
	fi
}

container_user () {

	# authentication

	frobulator.fwd "Authenticating${marker_elp}"

	# verify user existence:
	# loop through container's /etc/passwd file and make sure 'user' exists
	# source environment variables when 'user' corresponds to 'username'
	# default to 'root' if 'username' is invalid, is not specified or does not exist

	line_passwd_last="$(tail -n 1 "${CONTAINER_ROOT}"/etc/passwd)"

	while read -r line_passwd
	do
		IFS=':'

		read USER _ USER_ID GROUP_ID GECOS HOME SHELL <<< "${line_passwd}"

		IFS=','

		read FULL_NAME ROOM_NUMBER WORK_PHONE HOME_PHONE USER_EMAIL <<< "${GECOS}"

		# reset IFS

		IFS=' '

		# verify login options and parameters

		# no user name specified

		if [[ -z "${name_user}" ]]
		then
			name_user="root"

			USER="root"

			USER_ID="0"
			GROUP_ID="0"

			UID="${USER_ID}"
			GID="${GROUP_ID}"

			if [ -d "${CONTAINER_ROOT}"/root ]
			then
				HOME="/root"
			else
				HOME="/"
			fi

			frobulator.wrn "No user name - Defaulting" "[ '${name_user}' ]"

			break
		fi

		# valid user name found

		if [[ "${name_user}" == "${USER}" ]]
		then
			USER="${name_user}"

			if [[ "${name_user}" == "root" ]]
			then
				frobulator.wrn "Valid user name - Superuser" "[ '${name_user}' ]"
			else
				frobulator.scs "Valid user name - Accessing" "[ '${name_user}' ]"
			fi

			break
		fi

		# user naem not found

		if [[ "${line_passwd}" == "${line_passwd_last}" ]]
		then

			frobulator.err "Invalid user name - Aborting" "[ '${name_user}' ]"

			exit 1
		fi

	done < "${CONTAINER_ROOT}"/etc/passwd
}

container_environment () {

	# generate container environment

	# set path:
	# in order of retreival

	CONTAINER_PATH=""

	# container

	[ -d "${CONTAINER_ROOT}"/usr/local/sbin ] && CONTAINER_PATH+="/usr/local/sbin:"
	[ -d "${CONTAINER_ROOT}"/usr/local/bin ]  && CONTAINER_PATH+="/usr/local/bin:"
	[ -d "${CONTAINER_ROOT}"/usr/sbin ]       && CONTAINER_PATH+="/usr/sbin:"
	[ -d "${CONTAINER_ROOT}"/usr/sbin ]       && CONTAINER_PATH+="/usr/bin:"
	[ -d "${CONTAINER_ROOT}"/sbin ]           && CONTAINER_PATH+="/sbin:"
	[ -d "${CONTAINER_ROOT}"/bin ]            && CONTAINER_PATH+="/bin:"

	# termux

	[ -d "${HOME}"/.local/bin ]               && CONTAINER_PATH+="${HOME}/.local/bin:"

	[ -d "${PREFIX}"/sbin ]                   && CONTAINER_PATH+="${PREFIX}/sbin:"
	[ -d "${PREFIX}"/bin ]                    && CONTAINER_PATH+="${PREFIX}/bin:"

	# android

	[ -d /system/sbin ]                       && CONTAINER_PATH+="/system/sbin:"
	[ -d /system/bin ]                        && CONTAINER_PATH+="/system/bin:"

	CONTAINER_PATH="${CONTAINER_PATH}"

	export CONTAINER_PATH="${CONTAINER_PATH}"

	return
}

container_intent () {

	# load session settings

	# assume 'termux-exec' is installed

	unset LD_PRELOAD

	# generate container environment

	container_environment

	# setup 'proot' command arguments

	unset command_session

	command_session+="proot"
	command_session+=" --kill-on-exit"
	command_session+=" --link2symlink"
	command_session+=" --rootfs=${CONTAINER_ROOT}"
	command_session+=" --change-id=${USER_ID}:${GROUP_ID}"
	command_session+=" --pwd=${HOME}"

    [ -d "/apex" ]                                && command_session+=" --bind=/apex:/apex"
    [ -e "/linkerconfig/ld.config.txt" ]          && command_session+=" --bind=/linkerconfig/ld.config.txt:/linkerconfig/ld.config.txt"

	# system directories

    [ -d "/data" ]                                && command_session+=" --bind=/data:/data"
    [ -d "/dev" ]                                 && command_session+=" --bind=/dev:/dev"
    [ -e "/dev/urandom" ]                         && command_session+=" --bind=/dev/urandom:/dev/random"
    [ -d "/proc" ]                                && command_session+=" --bind=/proc:/proc"
    [ -d "/proc/self/fd" ]                        && command_session+=" --bind=/proc/self/fd:/dev/fd"
    [ -e "/proc/self/fd/0" ]                      && command_session+=" --bind=/proc/self/fd/0:/dev/stdin"
    [ -e "/proc/self/fd/1" ]                      && command_session+=" --bind=/proc/self/fd/1:/dev/stdout"
    [ -e "/proc/self/fd/2" ]                      && command_session+=" --bind=/proc/self/fd/2:/dev/stderr"
    [ -d "/storage" ]                             && command_session+=" --bind=/storage:/storage"
    [ -d "/sys" ]                                 && command_session+=" --bind=/sys:/sys"
    [ -d "/system" ]                              && command_session+=" --bind=/system:/system"
    [ -d "/vendor" ]                              && command_session+=" --bind=/vendor:/vendor"

	[ -d "${PREFIX%/*}"/home ]                    && command_session+=" --bind=${PREFIX%/*}/home:${HOME}"
	[ -d "${PREFIX}"/media ]                      && command_session+=" --bind=${PREFIX}/media:/media"
	[ -d "${PREFIX}"/tmp ]                        && command_session+=" --bind=${PREFIX}/tmp:/tmp"

	# environment

    command_session+=" env"
    command_session+=" --ignore-environment"

    # android

	command_session+=" ANDROID_ART_ROOT=${ANDROID_ART_ROOT}"
	command_session+=" ANDROID_DATA=${ANDROID_DATA}"
	command_session+=" ANDROID_I18N_ROOT=${ANDROID_I18N_ROOT}"
	command_session+=" ANDROID_ROOT=${ANDROID_ROOT}"
	command_session+=" ANDROID_RUNTIME_ROOT=${ANDROID_RUNTIME_ROOT}"
	command_session+=" ANDROID_TZDATA_ROOT=${ANDROID_TZDATA_ROOT}"
	command_session+=" BOOTCLASSPATH=${BOOTCLASSPATH}"
	command_session+=" DEX2OATBOOTCLASSPATH=${DEX2OATBOOTCLASSPATH}"

	# termux

	command_session+=" PREFIX=${PREFIX}"
	command_session+=" TERMUX_BINARIES=${PREFIX}/bin"
	command_session+=" TERMUX_VERSION=${TERMUX_VERSION}"

	# container

	command_session+=" PATH=${PATH}:${CONTAINER_PATH}"
	command_session+=" COLORTERM=${COLORTERM}"
	command_session+=" DISPLAY=${DISPLAY}"
	command_session+=" DISPLAY_DRIVER=${DISPLAY_DRIVER}"
	command_session+=" HOME=${HOME}"
	command_session+=" LANG=${LANG}"
	command_session+=" LOCALHOST=${LOCALHOST}"
	command_session+=" SHELL=${SHELL}"
	command_session+=" TERM=${TERM}"
	command_session+=" TMPDIR=${TMPDIR}"
	command_session+=" USER=${USER}"
	command_session+=" XDG_CACHE_HOME=${HOME}/.cache"
	command_session+=" XDG_CONFIG_DIRS=/etc/xdg"
	command_session+=" XDG_CONFIG_HOME=${HOME}/.config"
	command_session+=" XDG_DATA_DIRS=/usr/local/share:/usr/share"
	command_session+=" XDG_DATA_HOME=${HOME}/.local/share"
	command_session+=" XDG_RUNTIME_DIR=/run/user/${USER_ID}"
	command_session+=" XDG_STATE_HOME=${HOME}/.local/state"
	command_session+=" XAUTHORITY=${XDG_RUNTIME_DIR}/Xauthority"

	# command

	command_session+=" ${@}"

	# execute 'proot' login

	${command_session}
}

container_display () {

	activity_display="${activity_termux_x11}"

	command_intent=()

	command_intent+=(am start)
	command_intent+=(--user 0)
	command_intent+=(-n ${activity_display})

	frobulator.silence "${command_intent[@]}"
}

container_session () {

	# load session

	frobulator.fwd "Loading desktop interface${marker_elp}"

	if [ -z "${name_environment}" ]
	then
		name_environment="$(cat ${HOME}/.dextop/dextop-environment)"
	fi

	if [ -z "${name_session}" ]
	then
		name_session="$(cat ${HOME}/.dextop/dextop-session)"
	fi

	if [ "${name_environment}" = "xfce" ]
	then
		manager_window="xfwm4"

	elif [ "${name_environment}" = "i3" ]
	then
		manager_window="i3"
	fi

	# pause:
	# required to let session loader through messaging system
	# and load graphical interface

	sleep 2

	# load desktop environment

	frobulator.silence "dbus-launch --exit-with-session ${name_session}" &
}

container_focus () {

	local path_command

	# define window manager

	if [ -z "${name_environment}" ]
	then
		name_environment="$(cat ${HOME}/.dextop/dextop-environment)"
	fi

	if [ -z "${name_session}" ]
	then
		name_session="$(cat ${HOME}/.dextop/dextop-session)"
	fi

	if [ "${name_environment}" = "xfce" ]
	then
		manager_window="xfwm4"

	elif [ "${name_environment}" = "i3" ]
	then
		manager_window="i3"
	fi

	# define default application

	if [ "${name_environment}" = "xfce" ]
	then
		application_default="xfce4-appfinder"

	elif [ "${name_environment}" = "i3" ]
	then
		application_default="dmenu_run"
	fi

	if [ "$application" = "" ]
	then
		frobulator.wrn "Application not specified" "[ N/A ]"

		application="${application_default}"

		frobulator.cpt "Loading default" "[ ${application} ]"
	fi

	# ${application} command path - empty if not installed

	path_command="$(command -v "${application}")"

	if [ -z "${path_command}" ]
	then
		frobulator.err "Application not found" "[ ${application} ]"

		application="${application_default}"

		frobulator.cpt "Loading default" "[ ${application} ]"

	else
		frobulator.scs "Application found" "[ ${application} ]"

		application="${application}"

		frobulator.cpt "Loading application" "[ ${application} ]"
	fi

	# timeout:
	# required to let session loader through messaging system
	# and load graphical interface

	frobulator.timeout

	# load desktop environment

	"${manager_window}" > "${sink}" 2>&1 &

	# load application

	frobulator.silence "${application}" &
}

display_vnc_clean () {

	# clean vnc runtime files:
	# prevents hangups and vnc process misfires

	if [ -d "${HOME}" ]
	then
		rm -r -f "${HOME}"/.ICE*
		rm -r -f "${HOME}"/.X11*
		rm -r -f "${HOME}"/.Xauth*
	fi

	if [ -d "${TMPDIR}" ]
	then
		rm -r -f "${TMPDIR}"/.ICE*
		rm -r -f "${TMPDIR}"/.X11*
		rm -r -f "${TMPDIR}"/.Xauth*
	fi
}

