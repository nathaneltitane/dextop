#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-o|--start)
			option="start"
			mode_display="${2}"

			shift
		;;

		-x|--stop)
			option="stop"
			mode_display="${2}"

			shift
		;;

		-l|--list)
			option="list"
		;;

		-p|--password)
			option="password"
		;;

		-u|--username)
			option="username"
			name_user="${2}"

			shift
		;;

		-d|--directory)
			option="directory"
			directory_container="${2}"

			shift
		;;

		-f|--focus)
			option="focus"
			application="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -o [Display Server] | -x | -l | -u [User Name] | -d [Directory] | -f [Application] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-o, --start        Start display session server and [o]pen the desktop session."
			echo
			echo -e "                   [ vnc ]"
			echo -e "                   [ x11 ] [ Default ]"
			echo
			echo -e "-x, --stop         E[x]it the desktop session and stop the display session server."
			echo
			echo -e "-l, --list         Show [l]ist of display server information and parameters."
			echo
			echo -e "-p, --password     Generate display session [p]assword."
			echo
			echo -e "                   [ vnc ]"
			echo
			echo -e "-u, --username     Specify [u]ser name for session login."
			echo
			echo -e "-d, --directory    Specify container base [d]irectory containing /distribution/version."
			echo
			echo -e "-f, --focus        Set display session [f]ocus on the specified application."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -o [Display Server] | -x | -l | -u [User Name] | -d [Directory] | -f [Application] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

