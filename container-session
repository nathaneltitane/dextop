	list_geometries=(
		${list_monitors[@]}
		${list_devices[@]}
	)

	# set padding for uniform output

	length_pad=10

	# continue list using array selection of suppported values

	for (( index_entry = 0 ; index_entry < ${#list_geometries[@]} ; index_entry += 3 ))
	do
		label_geometry="${list_geometries[$index_entry]}"
		width_display="${list_geometries[$index_entry+1]}"
		height_display="${list_geometries[$index_entry+2]}"
		geometry="${width_display}x${height_display}"

		number_entry=$(( ( $index_entry / 3 ) + 1 ))

		if (( $index_entry / 3 >= 0 && $index_entry / 3 <= 8 ))
		then
			# handle number spacing for entries 1-9

			printf '      [  %s ] %s' ${number_entry} ${label_geometry}
		else
			# handle number spacing for entries 10+

			printf '      [ %s ] %s' ${number_entry} ${label_geometry}
		fi

		printf '%*s' $(( length_pad - ${#label_geometry} ))
		printf '%s\n' ${geometry}
	done

	printf '\n'
}

display_vnc_selection () {

	# values #

	list_values=(
		selection
	)

	# handle user input for list_values

	frobulator_return=()

	if [ -f "${HOME}"/.vnc/selection ]
	then
		selection=$(cat "${HOME}"/.vnc/selection)
	else
		frobulator.input ${list_values[@]}
	fi

	eval ${frobulator_return[@]}

	# check selection input against selection list

	while true
	do
		# range check:
		# selection input must be in provided range and an integer

		if [[ "${selection}" -lt 1           ]] ||
		   [[ "${selection}" -gt "${number_entry}" ]] ||
		   [[ ! "${selection}" =~ ^[0-9]+$   ]]
		then
			echo
			frobulator.err "Invalid selection:"

			frobulator.wrn "Select geometry [ 1 - ${number_entry} ] or input [c]ustom properties."

			frobulator.ipt "Selection:"

			frobulator.read selection
		else
			break
		fi

		if [[ "${selection}" = [cC] ]]
		then
			selection=custom

			break
		fi
	done

	unset geometry

	# integer check:
	# handle numerical selection

	if [[ "${selection}" =~ ^[0-9]+$ ]]
	then
		index_entry=$(( ${selection} ))
		index_entry=$(( $index_entry * 3 ))

		label_geometry="${list_geometries[$index_entry-3]}"
		width_display="${list_geometries[$index_entry-2]}"
		height_display="${list_geometries[$index_entry-1]}"
		geometry="${width_display}x${height_display}"
	fi

	# handle custom selection

	if [[ "${selection}" = "custom" ]]
	then
		frobulator.fwd "Setting custom properties${marker_elp}"

		frobulator.ipt "Set width" "[ pixels ]"

		frobulator.read width_display

		frobulator.ipt "Set height" "[ pixels ]"

		frobulator.read height_display

		frobulator.ipt "Set display number" "[ e.g. 1 ]"

		frobulator.read mode_display

		label_geometry="Custom"
		geometry="${width_display}x${height_display}"

		DISPLAY=":${mode_display}"
		DISPLAY_NUMBER="${DISPLAY/:/}"
		PORT="590${DISPLAY_NUMBER}"
	fi
}

display_vnc_password () {

	# handle vnc session password generation

	# values #

	list_values=(
		password_display
	)

	# handle user input for list_values

	frobulator_return=()

	frobulator.input ${list_values[@]}

	eval ${frobulator_return[@]}

	# hash password  using 'vncpasswd' and store it

	frobulator.fwd "Setting password${marker_elp}"

	echo "${password_display}" | vncpasswd -f > "${HOME}"/.vnc/passwd

	frobulator.scs "Password changed."
}

display_vnc_framebuffer () {

	# generate vnc framebuffer

	frobulator.fwd "Generating framebuffer${marker_elp}"

	unset command_framebuffer

	command_framebuffer+="Xvfb"
	command_framebuffer+=" -screen ${DISPLAY_NUMBER}"
	command_framebuffer+=" ${geometry}x24"

	${command_framebuffer} > "${sink}" 2>&1 &
}

display_vnc_initialize () {

	# initilaize vnc session and parameters

	# make selection available for automatic start:
	# verify user id - do not write selection when 'root' user is logged in

	local user_current

	# logged in user name

	user_current="$(id -u -n)"

	if [ "${user_current}" = "root" ]
	then
		:
	else
		# integer check:
		# do not write non numerical values to file

		if [[ "${selection}" =~ ^[0-9]+$ ]]
		then
			if [ ! -d "${HOME}"/.vnc ]
			then
				mkdir -p "${HOME}"/.vnc
			fi

			echo "${selection}" > "${HOME}"/.vnc/selection
			echo "${label_geometry}"    > "${HOME}"/.vnc/format
			echo "${geometry}"  > "${HOME}"/.vnc/geometry
		fi
	fi

	# genrate vnc display framebuffer

	display_vnc_framebuffer
}

display_vnc_server () {

	# start vnc display server

	command_server+="x11vnc"
	command_server+=" -display ${DISPLAY}"
	command_server+=" -clip xinerama=${DISPLAY}"
	command_server+=" -rfbport ${PORT}"
	command_server+=" -scale 1.00"
	command_server+=" -xkb"
	command_server+=" -nocursor"
	command_server+=" -nocursorshape"
	command_server+=" -noshm"
	command_server+=" -noxdamage"
	command_server+=" -noxfixes"
	command_server+=" -noxrecord"

	${command_server} > "${sink}" 2>&1 &

}

display_vnc_intent () {

	# start vnc display activity

	# explicit VNC viewer application to kill:
	# used when vnc is stopped or restarted using vnc:// intent
	# when launched via the activity manager
	# [ 'am start -d {URI} -S {ACTIVITY}' ]

	# start android vnc intent and force-stop existing activity

	# frobulator.silence "am start
	#						--user 0
	#						-a android.intent.action.VIEW
	#						-d vnc://${ADDRESS}:${PORT}
	#						-S ${activity_display}"

	activity_display="${activity_vnc}"

	unset command_intent

	command_intent+="am start"
	command_intent+=" --user 0"
	command_intent+=" -a android.intent.action.VIEW"
	command_intent+=" -d vnc://${ADDRESS}:${PORT}"
	command_intent+=" -S ${activity_display}"

	frobulator.silence "${command_intent}"

}

display_vnc_start () {

	local id_process_vnc

	# running vnc server process ids - empty if stopped

	id_process_vnc="$(pgrep -f x11vnc)"

	if [ -n "${id_process_vnc}" ]
	then
		:
	else
		# handle display geometry selection

		if [ -f "${HOME}"/.vnc/selection ]
		then
			# hide if selection file is present

			display_vnc_geometry > "${sink}" 2>&1
		else
			# show if selection file is not present

			display_vnc_geometry
		fi

		# handle vnc selections

		display_vnc_selection

	fi

	# initialize vnc parameters

	display_vnc_initialize

	# start vnc display server

	display_vnc_server

	# load vnc viewer intent

	display_vnc_intent
}

display_vnc_stop () {

	# look for corresponding server process:
	# stop display server and clean runtime files

	local id_process_framebuffer
	local id_process_vnc

	# running framebuffer and vnc server process ids - empty if stopped

	id_process_framebuffer="$(pgrep -f Xvfb)"
	id_process_vnc="$(pgrep -f x11vnc)"

	if [ -n "${id_process_framebuffer}" ]
	then
		# framebuffer

		pkill -f Xvfb  > "${sink}" 2>&1 &

		frobulator.process "Stopping display framebuffer"

	elif [ -n "${id_process_vnc}" ]
	then
		# vnc

		x11vnc -R stop > "${sink}" 2>&1 &

		frobulator.process "Stopping display server"

		wait

		# clean display server runtime files

		display_vnc_clean &

		frobulator.process "Removing display runtime files"

	else
		frobulator.wrn "No active display server detected."

		frobulator.fwd "Exiting${marker_elp}"
	fi
}

display_x11_server () {

	local id_process_dbus
	local id_process_accelerator
	local id_process_x11_application

	# start x11 display server

	GALLIUM_DRIVER="${TERMUX_X11_DRIVER}"

	export GALLIUM_DRIVER="${GALLIUM_DRIVER}"

	# running dbus and graphics accelerator process ids - empty if stopped

	id_process_dbus="$(pgrep -f dbus)"
	id_process_accelerator="$(pgrep -f "${TERMUX_X11_ACCELERATOR}")"

	if [ -n "${id_process_dbus}" ]
	then
		pkill -f dbus
	fi

	if [ -n "${id_process_accelerator}" ]
	then
		pkill -f "${TERMUX_X11_ACCELERATOR}"
	fi

	frobulator.silence "${TERMUX_X11_ACCELERATOR}" &

	# running termux x11 application process ids - empty if stopped

	id_process_x11_application="$(pgrep -f "${TERMUX_X11_APPLICATION}")"

	if [ -n "${id_process_x11_application}" ]
	then
		:
	else
		frobulator.silence "${TERMUX_X11_SERVER} ${DISPLAY}" &
	fi
}

display_x11_intent () {

	# start x11 display activity

	frobulator.fwd "Opening display${marker_elp}"

	activity_display="${activity_termux_x11}"

	unset command_intent

	command_intent+="am start"
	command_intent+=" --user 0"
	command_intent+=" -n ${activity_display}"

	frobulator.silence "${command_intent}" &
}

display_x11_start () {

	display_x11_server

	display_x11_intent
}

display_x11_stop () {

	# stop display server and activity

	local id_process_x11_application

	# running termux x11 application process ids - empty if stopped

	id_process_x11_application="$(pgrep -f "${TERMUX_X11_APPLICATION}")"

	if [ -n "${id_process_x11_application}" ]
	then
		pkill -f "${TERMUX_X11_APPLICATION}"

		activity_display="${activity_termux_x11_stop}"

		command_intent=()

		command_intent+=(am broadcast)
		command_intent+=(--user 0)
		command_intent+=(-a ${activity_display})

		frobulator.silence "${command_intent[@]}" &

		frobulator.process "Stopping display viewer"
	else
		frobulator.wrn "No active display process detected."

		frobulator.fwd "Exiting${marker_elp}"
	fi
}

list_display () {

	if [[ "${mode_display}" = [vV][nN][cC] ]]
	then
		server_display="x11vnc"

		format_display=$(cat "${HOME}"/.vnc/format)
		geometry_display=$(cat "${HOME}"/.vnc/geometry)
		name_display=${DISPLAY}
		read -r -a list_names_server_display <<< "${server_display}"

		id_process_display=$(pidof "${list_names_server_display[@]}")
		port_display="${PORT}"
	fi

	if [[ "${mode_display}" = [xX][1][1] ]]
	then
		server_display="app_process / com.termux.x11.Loader"

		format_display="native"
		geometry_display="native"
		name_display=${DISPLAY}
		read -r -a list_names_server_display <<< "${server_display}"

		id_process_display=$(pidof "${list_names_server_display[@]}")
		port_display="default"
	fi

	if [ -n "${id_process_display}" ]
	then
		frobulator.fwd "Listing session details${marker_elp}"

		format_display="${format_display}"
		geometry_display="${geometry_display}"
		name_display="${name_display}"
		id_process_display="${id_process_display}"
		port_display="${port_display}"
	else
		frobulator.wrn "No active servers detected."

		value_empty="N/A"

		format_display="${value_empty}"
		geometry_display="${value_empty}"
		name_display="${value_empty}"
		id_process_display="${value_empty}"
		port_display="${value_empty}"
	fi

	frobulator.inf "Format"   "[ ${format_display} ]"
	frobulator.inf "Geometry" "[ ${geometry_display} ]"
	frobulator.inf "Display"  "[ ${name_display} ]"
	frobulator.inf "Process"  "[ ${id_process_display} ]"
	frobulator.inf "Port"     "[ ${port_display} ]"
}

