#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-s|--selection)
			option="selection"
			selection="${2}"

			if [ "${selection}" = "addon" ]
			then
				addon="${3}"

				shift
			fi

			shift

		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -s [Selection Type] [Addon Name] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-s, --selection    Update application package [s]election."
			echo
			echo -e "                   [ all ]"
			echo -e "                   [ addon ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -s [Selection Type] [Addon Name] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

intent_install () {

	# process addon package installtion

	addon="package-termux-${addon}.apk"

	frobulator.download get.trmnl.me "${PREFIX}"/tmp "${addon}"

	intent_open "${PREFIX}"/tmp/"${addon}"

	frobulator.countdown 10 "Installing" "[ ${addon} ]"
}

intent_addon () {

	# load termux addons

	list_addons+=(
		api
		gui
		styling
		tasker
		x11
	)

	if [[ "${option}" = "selection" ]]
	then
		if [[ ${list_addons[@]} =~ "${addon}" ]]
		then
			intent_install

		elif [[ "${addon}" = "all" ]]
		then
			for addon in ${list_addons[@]}
			do
				intent_install

				frobulator.file "${HOME}"/.dextop termux-addon-"${addon}"
			done

			frobulator.file "${HOME}"/.dextop termux-addons

		else
			frobulator.err "Unknown addon name" "[ '${addon}' ]"

			frobulator.fwd "Listing known addons${marker_elp}"

			frobulator.timeout

			IFS=$'\n'

			printf "${marker_nul} %s\n" ${list_utilities[@]}

			echo

			IFS=''

			frobulator.msg "Review utility name spelling and try again."

			frobulator.inf "Update all known utilities using 'all' argument."

			exit 1
		fi
	fi

	list_addons=()
}

intent_open () {

	command_open=()

	command_open+=(am broadcast)
	command_open+=(--user 0)
	command_open+=(-a android.intent.action.VIEW)
	command_open+=(-n com.termux/com.termux.app.TermuxOpenReceiver)
	command_open+=(-d ${@})

	frobulator.silence "${command_open[@]}"
}

intent_clean () {

	rm					\
		--recursive		\
		--force			 "${PREFIX}"/tmp/*.apk
}

trap 'intent_clean' EXIT

# notice

frobulator.inf "This utility sets up Termux project addons:"
frobulator.nul "The addons are fetched directly from their respective GitHub project release pages."

frobulator.wrn "Enable 'Install unknown apps' permission for Termux and all other companion applications:"
frobulator.nul "Settings > Security and Privacy > Install unknown apps > Termux[:Application]"

frobulator.ins "Select 'Package Installer' when prompted to proceed."

frobulator.separate

frobulator.qst "Install Termux addons?"

frobulator.read reply

if [[ "${reply}" = [yY]         ]] ||
   [[ "${reply}" = [yY][eE][sS] ]]
then
	addon="all"

	frobulator.inf "Setting up all Termux addon packages."

	frobulator.fwd "Installing${marker_elp}"

else
	frobulator.wrn "X11 server sessions require Termux:X11 to be installed."

	frobulator.inf "Restart this utility to install the companion application"
	frobulator.nul "or fetch the package manually from the project release page."

	exit
fi

intent_addon

frobulator.countdown 5 "Continuing" "[ ${script} ]"
