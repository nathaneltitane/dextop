#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="${BASH_SOURCE[0]##*/}"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"

		while IFS=':' read -r name_passwd _ _ _ _ home_passwd _
		do
			if [ "${name_passwd}" = "${SUDO_USER}" ]
			then
				HOME="${home_passwd}"
			fi
		done < /etc/passwd
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-23"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--information)
			option="information"
			name_user="${2}"

			shift
		;;

		-s|--superuser)
			option="superuser"
			name_user="${2}"

			shift
		;;

		-u|--username)
			option="username"
			name_user="${2}"

			shift
		;;

		-p|--password)
			option="password"
			password_user="${2}"

			shift
		;;

		-n|--hostname)
			option="hostname"
			name_host="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --information    Gather setup [i]nformation."
			echo
			echo -e "-u, --username       Set up [u]ser account."
			echo
			echo -e "-p, --password       Set or change user [p]assword."
			echo
			echo -e "-n, --hostname       Set container host[n]ame."
			echo
			echo -e "-h, --help           Show [h]elp and usage information."
			echo
			echo -e "'${script}'          [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# container hostname - android hostname is not meaningful

name_host_default="dextop"

# functions ────────────────────────────────────────────────────────────────────

user_verify () {

	# authentication

	frobulator.fwd "Verifying${marker_elp}"

	# verify user existence:
	# loop through container's /etc/passwd file and check if 'user' exists

	unset status_user

	while read -r line_passwd
	do
		IFS=':'

		read USER _ USER_ID GROUP_ID GECOS HOME SHELL <<< "${line_passwd}"

		IFS=','

		read FULL_NAME ROOM_NUMBER WORK_PHONE HOME_PHONE USER_EMAIL <<< "${GECOS}"

		# reset IFS

		IFS=' '

		# valid user name found

		if [[ "${name_user}" == "${USER}" ]]
		then

			frobulator.scs "User name exists" "[ '${name_user}' ]"

			status_user="found"

			break
		fi

	done < /etc/passwd

	# user name not found

	if [ -z "${status_user}" ]
	then
		frobulator.err "User name does not exist" "[ '${name_user}' ]"

		frobulator.wrn "User must exist before proceeding."

		exit 1
	fi
}

user_password_generate () {

	local length_password="${1:-32}"
	local LC_ALL=C

	local chunk_random
	local password_generated

	# generate random password

	while [ "${#password_generated}" -lt "${length_password}" ]
	do
		IFS= read -r -n 64 -d '' chunk_random < /dev/urandom

		# keep letters and digits

		password_generated+="${chunk_random//[^a-zA-Z0-9]/}"
	done

	echo "${password_generated:0:${length_password}}"
}

user_information () {

	# get 'user' information

	frobulator.inf "This information will be used to set up the user account."

	frobulator.wrn "Information is required to set up your environment:"
	frobulator.wrn "Fields cannot be empty."

	# handle user input for list_information

	frobulator_return=()

	frobulator.input ${list[@]}

	eval ${frobulator_return[@]}
}

user_interactive () {

	# generate 'user' account:
	# interactive setup

	frobulator.fwd "Generating account${marker_elp}"

	number_room=""
	number_work=""
	number_home=""

	gecos+="${name_first} ${name_last},"
	gecos+="${number_room},"
	gecos+="${number_work},"
	gecos+="${number_home},"
	gecos+="${email_user}"

	directory_home="/home/${name_user}"

	user_create
}

user_automated () {

	# generate 'user account:
	# noninteractive setup


	frobulator.fwd "Generating account${marker_elp}"

	if [ -z "${name_user}" ]
	then
		name_user="termux"
	fi

	if [ -z "${password_user}" ]
	then
		password_user=$(user_password_generate)
	fi

	gecos="Dextop"
	directory_home="/home/${name_user}"

	user_create
}

user_create () {

	local date_current
	local id_entry
	local name_entry
	local status_user
	local text_id_used

	# generate 'user' entries

	unset id_user
	unset id_group_user

	# existing user and used ids

	while IFS=':' read -r name_entry _ id_entry _
	do
		if [ "${name_entry}" = "${name_user}" ]
		then
			status_user="found"
		fi

		text_id_used+=" ${id_entry} "
	done < /etc/passwd

	while IFS=':' read -r name_entry _ id_entry _
	do
		if [ "${name_entry}" = "${name_user}" ]
		then
			id_group_user="${id_entry}"
		fi

		text_id_used+=" ${id_entry} "
	done < /etc/group

	if [ -n "${status_user}" ]
	then
		frobulator.wrn "User exists" "[ ${name_user} ]"

		return
	fi

	frobulator.wrn "Creating user" "[ ${name_user} ]"

	# first free id from 1000

	id_user="1000"

	while [[ "${text_id_used}" == *" ${id_user} "* ]]
	do
		(( id_user++ ))
	done

	# user group

	if [ -z "${id_group_user}" ]
	then
		id_group_user="${id_user}"

		echo "${name_user}:x:${id_group_user}:" >> /etc/group

		if [ -f /etc/gshadow ]
		then
			echo "${name_user}:!::" >> /etc/gshadow
		fi
	fi

	# user entry

	echo "${name_user}:x:${id_user}:${id_group_user}:${gecos}:${directory_home}:${SHELL}" >> /etc/passwd

	if [ -f /etc/shadow ]
	then
		printf -v date_current '%(%s)T' -1

		echo "${name_user}:!:$(( date_current / 86400 )):0:99999:7:::" >> /etc/shadow
	fi

	# user home

	frobulator.directory /home "${name_user}"

	if [ -d /etc/skel ]
	then
		cp -a /etc/skel/. "${directory_home}"
	fi

	chown -R "${id_user}":"${id_group_user}" "${directory_home}"
}

user_superuser () {

	local command_sudo
	local index_group
	local line_group
	local list_group
	local member_group
	local status_group

	# generate 'user' superuser privilege

	# 'sudo' path - empty if not installed

	command_sudo="$(command -v sudo)"

	if [ -n "${command_sudo}" ]
	then
		frobulator.fwd "Generating superuser privilege${marker_elp}"

		# add 'user' to 'sudo' group

		mapfile -t list_group < /etc/group

		for index_group in "${!list_group[@]}"
		do
			line_group="${list_group[${index_group}]}"

			if [ "${line_group%%:*}" = "sudo" ]
			then
				status_group="found"

				member_group="${line_group##*:}"

				# keep existing members

				if [[ ",${member_group}," != *",${name_user},"* ]]
				then
					if [ -n "${member_group}" ]
					then
						list_group[${index_group}]="${line_group},${name_user}"
					else
						list_group[${index_group}]="${line_group}${name_user}"
					fi
				fi
			fi
		done

		# create missing 'sudo' group

		if [ -z "${status_group}" ]
		then
			list_group+=("sudo:x:27:${name_user}")
		fi

		printf '%s\n' "${list_group[@]}" > /etc/group

	else

		frobulator.err "Command must be installed to proceed" "[ 'sudo' ]"

		frobulator.inf "Install 'sudo' using the system package manager and try again."
	fi
}

user_superuser_override () {

	local command_sudo
	local count_line
	local file_sudoers_temporary
	local status_sudoers

	# set 'user' superuser privilege password override

	# 'sudo' path - empty if not installed

	command_sudo="$(command -v sudo)"

	if [ -n "${command_sudo}" ]
	then
		# verify sudoers default directory existence

		if [ -d /etc/sudoers.d ]
		then

			# set password override

			file_sudoers_temporary="$(mktemp)"

			echo "${name_user} ALL=(ALL) NOPASSWD: ALL" > "${file_sudoers_temporary}"

			visudo -c -q -f "${file_sudoers_temporary}"

			status_sudoers="${?}"

			if [ "${status_sudoers}" -eq 0 ]
			then
				cp "${file_sudoers_temporary}" /etc/sudoers.d/"${name_user}"

				# reset password override ownership:
				# fixes 'sudo' errors

				chmod 0440 /etc/sudoers.d/"${name_user}"
			else
				frobulator.err "Sudoers check failed - left unchanged" "[ /etc/sudoers.d/${name_user} ]"
			fi

			rm -f "${file_sudoers_temporary}"

			# fix superuser privilege runtime errors

			count_line="$(grep -c -x -F "Set disable_coredump false" /etc/sudo.conf 2> /dev/null)"

			if [ "${count_line:-0}" -eq 0 ]
			then
				frobulator.write append "Set disable_coredump false" /etc sudo.conf
			fi
		fi

	else

		frobulator.err "Command must be installed to proceed" "[ 'sudo' ]"

		frobulator.inf "Install 'sudo' using the system package manager and try again."
	fi
}

password_user () {

	# set 'user' password

	frobulator.fwd "Setting password${marker_elp}"

	# generate password credential for 'user' entry

	# silent configuration:
	# use 'chpasswd' to append user password to account

	chpasswd <<< "${name_user}:${password_user}"
}

hostname_container () {

	local file_hosts="/etc/hosts"
	local file_hostname="/etc/hostname"
	local address_host="127.0.1.1"

	local line_hosts
	local list_hosts=()

	# set container hostname

	frobulator.fwd "Setting hostname${marker_elp}"

	name_host="${name_host:-${name_host_default}}"

	# letters, digits and hyphens - default otherwise

	if [[ ! "${name_host}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]
	then
		frobulator.wrn "Invalid hostname - using default" "[ ${name_host} // ${name_host_default} ]"

		name_host="${name_host_default}"
	fi

	echo "${name_host}" > "${file_hostname}"

	# replace any previous hostname entry

	if [ -f "${file_hosts}" ]
	then
		while IFS= read -r line_hosts || [ -n "${line_hosts}" ]
		do
			if [[ "${line_hosts}" != "${address_host}"[[:space:]]* ]]
			then
				list_hosts+=("${line_hosts}")
			fi
		done < "${file_hosts}"
	fi

	list_hosts+=("${address_host}	${name_host}")

	printf '%s\n' "${list_hosts[@]}" > "${file_hosts}"
}

user_runtime () {

	# generate 'user' runtime directory structure


	frobulator.fwd "Setting runtime${marker_elp}"

	id_user="$(id -u ${name_user})"
	id_group_user="$(id -g ${name_user})"

	# generate runtime directory

	frobulator.directory /run/user "${id_user}"
	frobulator.directory /run/user "${name_user}"

	# set runtime directory permissions

	chmod 700 /run/user/"${id_user}"
	chmod 700 /run/user/"${name_user}"

	# set runtime directory ownership

	chown "${id_user}":"${id_group_user}" -R /run/user/"${id_user}"
	chown "${id_user}":"${id_group_user}" -R /run/user/"${name_user}"
}

if [ "${option}" = "information" ]
then
	if [ -z "${name_user}" ]
	then
		list_information+=(name_user)
	fi

	if [ -z "${name_first}" ]
	then
		list_information+=(name_first)
	fi

	if [ -z "${name_last}" ]
	then
		list_information+=(name_last)
	fi

	if [ -z "${email_user}" ]
	then
		list_information+=(email_user)
	fi

	if [ -z "${password_user}" ]
	then
		list_information+=(password_user)
	fi

	if [ -z "${name_host}" ]
	then
		list_information+=(name_host)
	fi

	list=(
		${list_information[@]}
	)

	user_information

	export name_user="${name_user}"
	export name_first="${name_first}"
	export name_last="${name_last}"
	export email_user="${email_user}"
	export password_user="${password_user}"
	export name_host="${name_host}"
fi

if [ "${option}" = "hostname" ]
then
	if [ -z "${name_host}" ]
	then
		list_information+=(name_host)
	fi

	list=(
		${list_information[@]}
	)

	user_information

	hostname_container
fi

if [ "${option}" = "password" ]
then
	if [ -z "${password_user}" ]
	then
		list_information+=(password_user)
	fi

	list=(
		${list_information[@]}
	)

	user_information

	password_user
fi

if [ "${option}" = "superuser" ]
then
	frobulator.install sudo

	if [ -z "${name_user}" ]
	then
		list_information+=(name_user)
	fi

	list=(
		${list_information[@]}
	)

	user_information

	user_verify

	# generate 'user' superuser privilege

	user_superuser

	# set 'user 'superuser password override

	user_superuser_override
fi

if [ "${option}" = "username" ]
then
	if [ -z "${name_user}" ]
	then
		list_information+=(name_user)
	fi

	if [ -z "${name_first}" ]
	then
		list_information+=(name_first)
	fi

	if [ -z "${name_last}" ]
	then
		list_information+=(name_last)
	fi

	if [ -z "${email_user}" ]
	then
		list_information+=(email_user)
	fi

	if [ -z "${password_user}" ]
	then
		list_information+=(password_user)
	fi

	if [ -z "${name_host}" ]
	then
		list_information+=(name_host)
	fi

	list=(
		${list_information[@]}
	)

	user_information

	# generate 'user' account: interactive

	user_interactive

	# set 'user' password

	password_user

	# set container hostname

	hostname_container

	# generate 'user' runtime directory structure

	user_runtime
fi

if [ -z "${option}" ] || [ "${option}" = "information" ]
then

	# generate 'user' account: automated

	user_automated

	# set 'user' password

	password_user

	# generate 'user' superuser privilege

	user_superuser

	# set 'user 'superuser password override

	user_superuser_override

	# set container hostname

	hostname_container

	# generate 'user' runtime directory structure

	user_runtime
fi
